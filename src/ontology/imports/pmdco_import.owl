AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020256> "has numerator"@en)
AnnotationAssertion(skos:definition <https://w3id.org/pmd/co/PMD_0020256> "points to a numerator of a quotient"@en)
SubObjectPropertyOf(<https://w3id.org/pmd/co/PMD_0020256> obo:RO_0002328)
FunctionalObjectProperty(<https://w3id.org/pmd/co/PMD_0020256>)

# Object Property: <https://w3id.org/pmd/co/PMD_0020257> (has denominator)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020257> "has denominator"@en)
AnnotationAssertion(skos:definition <https://w3id.org/pmd/co/PMD_0020257> "points to a denominator of a quotient"@en)
SubObjectPropertyOf(<https://w3id.org/pmd/co/PMD_0020257> obo:RO_0002328)
FunctionalObjectProperty(<https://w3id.org/pmd/co/PMD_0020257>)

# Object Property: <https://w3id.org/pmd/co/PMD_0025006> (process attribute of)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0025006> "process attribute of"@en)
AnnotationAssertion(skos:definition <https://w3id.org/pmd/co/PMD_0025006> "A relation between a process attribute and a process, which \"bears\" the attribute."@en)
AnnotationAssertion(skos:example <https://w3id.org/pmd/co/PMD_0025006> "Tensile rate is a process attribute of tensile test"@en)

# Object Property: <https://w3id.org/pmd/co/PMD_0025013> (changes quality)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0025013> "changes quality"@en)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0025013> "verändert die Qualität"@de)
AnnotationAssertion(skos:definition <https://w3id.org/pmd/co/PMD_0025013> "indicates that a process changes a quality"@en)
AnnotationAssertion(skos:definition <https://w3id.org/pmd/co/PMD_0025013> "zeigt an, dass ein Prozess eine Qualität verändert"@de)
ObjectPropertyDomain(<https://w3id.org/pmd/co/PMD_0025013> obo:BFO_0000015)
ObjectPropertyRange(<https://w3id.org/pmd/co/PMD_0025013> obo:BFO_0000019)

# Object Property: <https://w3id.org/pmd/co/PMD_0025998> (hat relationale Eigenschaft)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0025998> "has relational property"@en)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0025998> "hat relationale Eigenschaft"@de)
AnnotationAssertion(skos:definition <https://w3id.org/pmd/co/PMD_0025998> "a relation between an independent continuant (the bearer) and a relational quality, in which the quality specifically depends on the bearer for its existence"@en)
AnnotationAssertion(skos:definition <https://w3id.org/pmd/co/PMD_0025998> "eine Beziehung zwischen einem unabhängigen Kontinuum (dem Träger) und einer relationalen Qualität, bei der die Qualität in ihrer Existenz speziell vom Träger abhängt"@de)
AnnotationAssertion(skos:example <https://w3id.org/pmd/co/PMD_0025998> "material has relational quality mass proportion m, and portion of iron has the same relational quality mass proportion m"@en)
InverseObjectProperties(<https://w3id.org/pmd/co/PMD_0025998> <https://w3id.org/pmd/co/PMD_0025999>)
ObjectPropertyDomain(<https://w3id.org/pmd/co/PMD_0025998> obo:BFO_0000004)
ObjectPropertyRange(<https://w3id.org/pmd/co/PMD_0025998> <https://w3id.org/pmd/co/PMD_0020108>)

# Object Property: <https://w3id.org/pmd/co/PMD_0025999> (relationale Eigenschaft von)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0025999> "relational property of"@en)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0025999> "relationale Eigenschaft von"@de)
AnnotationAssertion(skos:definition <https://w3id.org/pmd/co/PMD_0025999> "a relation between a relational quality and an independent continuant (the bearer), in which the quality specifically depends on the bearer for its existence"@en)
AnnotationAssertion(skos:definition <https://w3id.org/pmd/co/PMD_0025999> "eine Beziehung zwischen einer relationalen Qualität und einem unabhängigen Kontinuum (dem Träger), bei der die Existenz der Qualität speziell vom Träger abhängt"@de)
AnnotationAssertion(skos:example <https://w3id.org/pmd/co/PMD_0025999> "mass proportion m is relational qualitiy of material, and the same mass proportion m is relational qualitiy of portion of iron"@en)

# Object Property: <https://w3id.org/pmd/co/PMD_0060001> (represents value of)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0060001> "represents value of"@en)
AnnotationAssertion(skos:definition <https://w3id.org/pmd/co/PMD_0060001> "A relation between an information content entity and an specifically dependent continuant or process attribute which the representation is about.")
SubObjectPropertyOf(<https://w3id.org/pmd/co/PMD_0060001> obo:IAO_0000136)
InverseObjectProperties(<https://w3id.org/pmd/co/PMD_0060001> <https://w3id.org/pmd/co/PMD_0060002>)
ObjectPropertyDomain(<https://w3id.org/pmd/co/PMD_0060001> obo:IAO_0000030)
ObjectPropertyRange(<https://w3id.org/pmd/co/PMD_0060001> ObjectUnionOf(obo:BFO_0000020 <https://w3id.org/pmd/co/PMD_0000008>))

# Object Property: <https://w3id.org/pmd/co/PMD_0060002> (represented by value)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0060002> "represented by value"@en)
AnnotationAssertion(skos:definition <https://w3id.org/pmd/co/PMD_0060002> "A relation between a specifically dependent continuant or process attribute and an information content entity which is about.")
SubObjectPropertyOf(<https://w3id.org/pmd/co/PMD_0060002> <https://w3id.org/pmd/co/PMD_0000004>)


