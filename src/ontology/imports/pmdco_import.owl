AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0001044> "DEPRECATED date value specification"@en)
AnnotationAssertion(owl:deprecated <https://w3id.org/pmd/co/PMD_0001044> "true"^^xsd:boolean)
AnnotationAssertion(skos:definition <https://w3id.org/pmd/co/PMD_0001044> "DEPRECATED A datum that represents a date or time interval associated with another specification.")

