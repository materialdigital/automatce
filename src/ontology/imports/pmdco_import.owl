AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020011> "OBSOLETE bravais lattice orthorhombic body-centered"@en)
AnnotationAssertion(owl:deprecated <https://w3id.org/pmd/co/PMD_0020011> "true"^^xsd:boolean)
AnnotationAssertion(skos:definition <https://w3id.org/pmd/co/PMD_0020011> "orthorhombic Bravais lattice with body-centered centering (oI), having three perpendicular 2-fold axes and an additional lattice point at the center of the unit cell"@en)
AnnotationAssertion(skos:definition <https://w3id.org/pmd/co/PMD_0020011> "orthorhombisches Bravais-Gitter mit körperzentrierter Zentrierung (oI), mit drei senkrechten zweizähligen Achsen und einem zusätzlichen Gitterpunkt in der Mitte der Elementarzelle"@de)

# Individual: <https://w3id.org/pmd/co/PMD_0020012> (OBSOLETE bravais lattice orthorhombic face-centered)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020012> "Bravais-Gitter orthorhombisch flächenzentriert"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020012> "OBSOLETE bravais lattice orthorhombic face-centered"@en)
AnnotationAssertion(owl:deprecated <https://w3id.org/pmd/co/PMD_0020012> "true"^^xsd:boolean)
AnnotationAssertion(skos:definition <https://w3id.org/pmd/co/PMD_0020012> "orthorhombic Bravais lattice with face-centered centering (oF), having three perpendicular 2-fold axes and additional lattice points at the centers of all faces"@en)
AnnotationAssertion(skos:definition <https://w3id.org/pmd/co/PMD_0020012> "orthorhombisches Bravais-Gitter mit flächenzentrierter Zentrierung (oF), mit drei senkrechten zweizähligen Achsen und zusätzlichen Gitterpunkten in den Mittelpunkten aller Flächen"@de)

# Individual: <https://w3id.org/pmd/co/PMD_0020013> (OBSOLETE bravais lattice tetragonal primitive)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020013> "Bravais-Gitter tetragonaler Grundkörper"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020013> "OBSOLETE bravais lattice tetragonal primitive"@en)
AnnotationAssertion(owl:deprecated <https://w3id.org/pmd/co/PMD_0020013> "true"^^xsd:boolean)
AnnotationAssertion(skos:definition <https://w3id.org/pmd/co/PMD_0020013> "tetragonal Bravais lattice with primitive centering (tP), having one 4-fold rotation axis with two equal unit cell axes perpendicular to a third unequal axis"@en)
AnnotationAssertion(skos:definition <https://w3id.org/pmd/co/PMD_0020013> "tetragonales Bravais-Gitter mit primitiver Zentrierung (tP), mit einer vierzähligen Rotationsachse mit zwei gleichen Elementarzellenachsen senkrecht zu einer dritten ungleichen Achse"@de)

# Individual: <https://w3id.org/pmd/co/PMD_0020014> (Bravais-Gitter tetragonal körperzentriert)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020014> "Bravais-Gitter tetragonal körperzentriert"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020014> "OBSOLETE bravais lattice tetragonal body-centered"@en)
AnnotationAssertion(owl:deprecated <https://w3id.org/pmd/co/PMD_0020014> "true"^^xsd:boolean)
AnnotationAssertion(skos:definition <https://w3id.org/pmd/co/PMD_0020014> "tetragonal Bravais lattice with body-centered centering (tI), having one 4-fold rotation axis and an additional lattice point at the center of the unit cell"@en)
AnnotationAssertion(skos:definition <https://w3id.org/pmd/co/PMD_0020014> "tetragonales Bravais-Gitter mit körperzentrierter Zentrierung (tI), einer 4-zähligen Rotationsachse und einem zusätzlichen Gitterpunkt im Zentrum der Elementarzelle"@de)

# Individual: <https://w3id.org/pmd/co/PMD_0020015> (Bravais-Gitter, sechseckiges, rhomboedrisches Grundelement)

AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020015> "Bravais-Gitter, sechseckiges, rhomboedrisches Grundelement"@de)
AnnotationAssertion(rdfs:label <https://w3id.org/pmd/co/PMD_0020015> "OBSOLETE bravais lattice hexagonal rhombohedral primitive"@en)
AnnotationAssertion(owl:deprecated <https://w3id.org/pmd/co/PMD_0020015> "true"^^xsd:boolean)
AnnotationAssertion(skos:definition <https://w3id.org/pmd/co/PMD_0020015> "trigonal Bravais lattice with rhombohedral centering (hR), having a 3-fold rotation axis and representable as a rhombohedron with equal axes and equal interaxial angles"@en)
AnnotationAssertion(skos:definition <https://w3id.org/pmd/co/PMD_0020015> "trigonales Bravais-Gitter mit rhomboedrischer Zentrierung (hR), einer dreizähligen Rotationsachse und darstellbar als Rhomboeder mit gleichen Achsen und gleichen Zwischenachsenwinkeln"@de)

# Individual: <https://w3id.org/pmd/co/PMD_0020016> (Bravais-Gitter sechseckiges sechseckiges Grundelement)

