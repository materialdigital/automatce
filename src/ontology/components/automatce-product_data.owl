Prefix: dcterms: <http://purl.org/dc/terms/>
Prefix: owl: <http://www.w3.org/2002/07/owl#>
Prefix: rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
Prefix: rdfs: <http://www.w3.org/2000/01/rdf-schema#>
Prefix: skos: <http://www.w3.org/2004/02/skos/core#>
Prefix: obo: <http://purl.obolibrary.org/obo/>
Prefix: pmd: <https://w3id.org/pmd/co/>
Prefix: log: <https://w3id.org/pmd/log/>
Prefix: xml: <http://www.w3.org/XML/1998/namespace>
Prefix: xsd: <http://www.w3.org/2001/XMLSchema#>
Prefix: : <https://w3id.org/pmd/automatce/components/automatce-product_data.owl>



Ontology: <https://w3id.org/pmd/automatce/components/automatce-product_data.owl>

Import: <https://w3id.org/pmd/automatce/components/automatce-shared.owl>

Annotations: 
    dcterms:title "AUTOMATCE - Product Data Module"@en,
    rdfs:comment "The product data module of the AUTOMATCE Ontology."@en

AnnotationProperty: dcterms:title

    
AnnotationProperty: rdfs:comment
AnnotationProperty: rdfs:label
AnnotationProperty: skos:altLabel
AnnotationProperty: skos:definition
AnnotationProperty: skos:example

    
Datatype: rdf:PlainLiteral


Class: obo:IAO_0000030
Class: obo:IAO_0000104
Class: obo:IAO_0020000
Class: obo:OBI_0001930
Class: obo:OBI_0001931
Class: obo:OBI_0001933
Class: pmd:PMD_0000891
Class: pmd:PMD_0020133
Class: pmd:PMD_0020138
Class: pmd:PMD_0025001
Class: log:LOG_0080002
Class: log:LOG_1000007


# Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010175> (batch)

Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010175>

  Annotations:
    rdfs:label "batch"@en,
    skos:definition "A disconnected material entity aggregate that is produced, handled, or traced as one quantity under a common production or logistics context."@en,
    skos:example "A batch of polymer granulate produced under one manufacturing order."@en

  SubClassOf:
    pmd:PMD_0020138


# Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010176> (catena-x batch identifier)

Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010176>

  Annotations:
    rdfs:label "catena-x batch identifier"@en,
    skos:altLabel "Catena-X identifier"@en,
    skos:definition "A batch identifier assigned for anonymous traceability of a batch in the Catena-X dataspace."@en,
    skos:example "A Catena-X identifier used to reference a batch without exposing a local production number."@en

  SubClassOf:
    log:LOG_0080002


# Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010177> (local identifier)

Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010177>

  Annotations:
    rdfs:label "local identifier"@en,
    skos:altLabel "local identifiers"@en,
    skos:definition "An identifier that identifies an entity within a stated local system, organization, or dataspace."@en,
    skos:example "A local batch number used inside a manufacturer's production system."@en

  SubClassOf:
    obo:IAO_0020000


# Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010178> (local identifier key)

Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010178>

  Annotations:
    rdfs:label "local identifier key"@en,
    skos:altLabel "identifier key"@en,
    skos:altLabel "key value list"@en,
    skos:definition "An information content entity that names the local identifier scheme or field in which an identifier value is given."@en,
    skos:example "A key such as plant batch number or supplier lot number in a key-value identifier list."@en

  SubClassOf:
    obo:IAO_0000030


# Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010179> (local identifier value)

Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010179>

  Annotations:
    rdfs:comment "Expected value datatype: xsd:string; expected unit: not specified."@en,
    rdfs:label "local identifier value"@en,
    skos:altLabel "identifier value"@en,
    skos:definition "An identifier value used within a stated local identifier scheme."@en,
    skos:example "The value 2024-11-A in a supplier lot identifier."@en

  SubClassOf:
    <https://w3id.org/pmd/automatce/AUTOMATCE_0010177>


# Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010180> (manufacturing information)

Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010180>

  Annotations:
    rdfs:label "manufacturing information"@en,
    skos:altLabel "manufacturing entity"@en,
    skos:definition "An information content entity that records production-related data about a batch, part, product, or material."@en,
    skos:example "Manufacturing date and manufacturing country recorded for a produced batch."@en

  SubClassOf:
    obo:IAO_0000030


# Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010181> (manufacturing country code)

Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010181>

  Annotations:
    rdfs:comment "Expected value datatype: xsd:string; expected code scheme: ISO 3166-1 alpha-2 or alpha-3."@en,
    rdfs:label "manufacturing country code"@en,
    skos:altLabel "country code"@en,
    skos:definition "An identifier that records the country in which a part, product, material, or batch was manufactured."@en,
    skos:example "\"DE\" as the manufacturing country code for a part manufactured in Germany."@en

  SubClassOf:
    obo:IAO_0020000


# Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010182> (part type information)

Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010182>

  Annotations:
    rdfs:label "part type information"@en,
    skos:definition "An information content entity that describes the designed part type instantiated by a physical part or batch."@en,
    skos:example "Part type information for a connector housing used across several produced parts."@en

  SubClassOf:
    obo:IAO_0000030


# Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010183> (manufacturer part number)

Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010183>

  Annotations:
    rdfs:comment "Expected value datatype: xsd:string; expected unit: not specified."@en,
    rdfs:label "manufacturer part number"@en,
    skos:altLabel "manufacturer part ID"@en,
    skos:definition "A part number assigned by the manufacturer to a designed part type."@en,
    skos:example "A manufacturer's part number for a steering control unit housing."@en

  SubClassOf:
    log:LOG_1000007


# Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010184> (part name at manufacturer)

Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010184>

  Annotations:
    rdfs:label "part name at manufacturer"@en,
    skos:definition "An identifier or designation by which a manufacturer names a part type in its own records."@en,
    skos:example "A manufacturer-specific sales or engineering name for a vehicle part."@en

  SubClassOf:
    obo:IAO_0020000


# Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010185> (product data)

Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010185>

  Annotations:
    rdfs:label "product data"@en,
    skos:definition "An information content entity that records identifying, descriptive, composition, or lifecycle data about a product."@en,
    skos:example "A vehicle product data record containing model range, brand, production date, and material composition."@en

  SubClassOf:
    obo:IAO_0000030


# Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010186> (model range)

Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010186>

  Annotations:
    rdfs:label "model range"@en,
    skos:definition "An identifier that records a vehicle sales or platform range used to group related model variants."@en,
    skos:example "A model range name used in a vehicle product data aspect."@en

  SubClassOf:
    obo:IAO_0020000


# Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010187> (overall material composition)

Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010187>

  Annotations:
    rdfs:label "overall material composition"@en,
    skos:definition "A composition that summarizes material groups and amounts at the level of a whole product or vehicle."@en,
    skos:example "Overall material composition of a vehicle reported for homologation."@en

  SubClassOf:
    pmd:PMD_0025001


# Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010188> (model range lifecycle)

Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010188>

  Annotations:
    rdfs:label "model range lifecycle"@en,
    skos:definition "An identifier that records the lifecycle state or generation of a vehicle model range."@en,
    skos:example "A lifecycle code for a vehicle series used in product data exchange."@en

  SubClassOf:
    obo:IAO_0020000


# Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010189> (sales name)

Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010189>

  Annotations:
    rdfs:label "sales name"@en,
    skos:definition "An identifier that records the commercial name under which a vehicle, part, or product is sold."@en,
    skos:example "The sales name shown in vehicle product data."@en

  SubClassOf:
    obo:IAO_0020000


# Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010190> (brand)

Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010190>

  Annotations:
    rdfs:label "brand"@en,
    skos:definition "An identifier that records the commercial brand associated with a vehicle, part, material, or product."@en,
    skos:example "A vehicle brand recorded in product data."@en

  SubClassOf:
    obo:IAO_0020000


# Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010191> (vehicle information)

Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010191>

  Annotations:
    rdfs:label "vehicle information"@en,
    skos:definition "An information content entity that records identifying, technical, lifecycle, or manufacturer data about a vehicle."@en,
    skos:example "Vehicle information containing original equipment manufacturer, model range, production date, and anonymized vehicle identification number."@en

  SubClassOf:
    obo:IAO_0000030


# ============================================================================
# EDCar BOM mapping additions (bill-of-materials structure and product master)
# ============================================================================

# Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010358> (bill of materials)

Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010358>

  Annotations:
    rdfs:label "bill of materials"@en,
    skos:altLabel "BOM"@en,
    skos:definition "A plan specification that prescribes the material components and the quantities required to manufacture a product."@en,
    skos:example "The bill of materials of a belt tensioner, listing each required component and its quantity."@en

  SubClassOf:
    obo:IAO_0000104


# Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010359> (bom position)

Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010359>

  Annotations:
    rdfs:label "bom position"@en,
    skos:altLabel "BOM item"@en,
    skos:definition "An information content entity that is about a required component of an assembly and states the quantity and item number of that requirement."@en,
    skos:example "Position 0010 of a belt tensioner bill of materials, requiring one bracket."@en

  SubClassOf:
    obo:IAO_0000030


# Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010360> (material master record)

Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010360>

  Annotations:
    rdfs:label "material master record"@en,
    skos:definition "An information content entity that is about a material at a plant and records its type, status, classification, base quantity, and weights."@en,
    skos:example "The plant 1001 master record of a steering component."@en

  SubClassOf:
    obo:IAO_0000030


# Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010361> (alternative item group)

Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010361>

  Annotations:
    rdfs:label "alternative item group"@en,
    skos:definition "An information content entity that groups the bill of materials positions which may substitute for one another to satisfy a single component requirement."@en,
    skos:example "A group holding two interchangeable fasteners ranked by usage probability."@en

  SubClassOf:
    obo:IAO_0000030


# Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010362> (product hierarchy node)

Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010362>

  Annotations:
    rdfs:comment "Expected value datatype: xsd:string."@en,
    rdfs:label "product hierarchy node"@en,
    skos:definition "An identifier that denotes the product hierarchy class to which a material is assigned."@en,
    skos:example "The product hierarchy code 0846194007 of a belt tensioner."@en

  SubClassOf:
    obo:IAO_0020000


# Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010363> (material group)

Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010363>

  Annotations:
    rdfs:comment "Expected value datatype: xsd:string."@en,
    rdfs:label "material group"@en,
    skos:definition "An identifier that denotes the material group, or commodity class, to which a material belongs."@en,
    skos:example "A material group code grouping metal stamping parts."@en

  SubClassOf:
    obo:IAO_0020000


# Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010364> (product segment)

Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010364>

  Annotations:
    rdfs:comment "Expected value datatype: xsd:string."@en,
    rdfs:label "product segment"@en,
    skos:definition "An identifier that denotes the functional product segment of a material."@en,
    skos:example "The segment 020000 Belt Tensioner of a material."@en

  SubClassOf:
    obo:IAO_0020000


# Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010365> (gross mass)

Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010365>

  Annotations:
    rdfs:label "gross mass"@en,
    skos:definition "A mass of a material entity that includes the mass of its packaging."@en,
    skos:example "The gross mass of one packaged component."@en

  SubClassOf:
    pmd:PMD_0020133


# Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010366> (net mass)

Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010366>

  Annotations:
    rdfs:label "net mass"@en,
    skos:definition "A mass of a material entity that excludes the mass of its packaging."@en,
    skos:example "The net mass of one unpackaged component."@en

  SubClassOf:
    pmd:PMD_0020133


# Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010367> (procurement type specification)

Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010367>

  Annotations:
    rdfs:label "procurement type specification"@en,
    skos:definition "A categorical value specification that states whether a material is produced in-house or procured externally."@en,
    skos:example "A procurement type whose value E denotes in-house production."@en

  SubClassOf:
    obo:OBI_0001930


# Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010368> (unit conversion factor)

Class: <https://w3id.org/pmd/automatce/AUTOMATCE_0010368>

  Annotations:
    rdfs:label "unit conversion factor"@en,
    skos:definition "A scalar value specification that states the factor for converting a quantity of a material from its base unit to another unit."@en,
    skos:example "A factor of one kilogram per piece for a component."@en

  SubClassOf:
    obo:OBI_0001931


