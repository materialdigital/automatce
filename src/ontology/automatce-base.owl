    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000003 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000023"/>
        <rdfs:comment xml:lang="en">Additives are distinct from fillers (which bulk up volume) and the matrix. They perform specific chemical or physical modifications.</rdfs:comment>
        <rdfs:label xml:lang="en">additive role</rdfs:label>
        <skos:definition xml:lang="en">A role borne by a substance intentionally added in relatively small amounts to modify the processing characteristics, performance properties, or cost of a base material.</skos:definition>
        <skos:example xml:lang="en">UV stabilizers added to dashboard polymers to prevent sun damage; Plasticizers added to PVC.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000004 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000004">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000868"/>
        <owl:disjointWith rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0000005"/>
        <rdfs:comment xml:lang="en">Organic colorants (dyes) offer high color strength and brightness but may have lower thermal stability than pigments.</rdfs:comment>
        <rdfs:label xml:lang="en">organic colorant</rdfs:label>
        <skos:definition xml:lang="en">A natural organic material used as a colorant in a polymer, coating, or other material system.</skos:definition>
        <skos:example xml:lang="en">Azo dyes used in interior textile coloring.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000005 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000005">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000002"/>
        <rdfs:comment xml:lang="en">Inorganic colorants (pigments) are generally insoluble and provide opacity and high heat stability.</rdfs:comment>
        <rdfs:label xml:lang="en">inorganic colorant</rdfs:label>
        <skos:definition xml:lang="en">An engineered material used as an inorganic colorant in a polymer, coating, or other material system.</skos:definition>
        <skos:example xml:lang="en">Titanium dioxide (white) used in car paints.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000006 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000006">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0000003"/>
        <rdfs:comment xml:lang="en">This role can be borne by organic dyes or inorganic pigments.</rdfs:comment>
        <rdfs:label xml:lang="en">colorant role</rdfs:label>
        <skos:definition xml:lang="en">A role borne by an additive substance when its primary function is to impart color to a material.</skos:definition>
        <skos:example xml:lang="en">Carbon black acting as a pigment to turn a tire black.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000007 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000007">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000952"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: MPa.</rdfs:comment>
        <rdfs:comment xml:lang="en">For brittle materials, this is equal to tensile strength. For ductile materials, it may be lower than the yield point.</rdfs:comment>
        <rdfs:label xml:lang="en">stress at break</rdfs:label>
        <skos:definition xml:lang="en">A strength that quantifies tensile stress at specimen rupture.</skos:definition>
        <skos:example xml:lang="en">A value of 150 MPa for a GF-reinforced polymer.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000008 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000008">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020131"/>
        <rdfs:comment xml:lang="en">Can be defined descriptively (Red) or metrologically (L*a*b* coordinates).</rdfs:comment>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:string; expected unit: not specified.</rdfs:comment>
        <rdfs:label xml:lang="en">color</rdfs:label>
        <skos:definition xml:lang="en">An optical property that characterizes reflected or transmitted light by hue, saturation, and brightness.</skos:definition>
        <skos:example xml:lang="en">The &apos;Piano Black&apos; finish on a B-pillar trim.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000009 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000009">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050004"/>
        <rdfs:comment xml:lang="en">Polyamides are semi-crystalline polymers known for good thermal and chemical resistance.</rdfs:comment>
        <rdfs:label xml:lang="en">polyamide</rdfs:label>
        <skos:definition xml:lang="en">A polymer containing repeating amide (-CONH-) linkages in the polymer backbone.</skos:definition>
        <skos:example xml:lang="en">Nylon 6, Nylon 12, Nylon 66.</skos:example>
        <co:PMD_0050117>PA</co:PMD_0050117>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000010 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000010">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0000009"/>
        <rdfs:comment xml:lang="en">PA66 has a higher melting point around 260 degC than PA6 but absorbs moisture, which affects dimensional stability.</rdfs:comment>
        <rdfs:label xml:lang="en">polyamide 66</rdfs:label>
        <skos:altLabel xml:lang="en">PA66</skos:altLabel>
        <skos:definition xml:lang="en">A semicrystalline thermoplastic polyamide synthesized from hexamethylenediamine and adipic acid.</skos:definition>
        <skos:example xml:lang="en">Material used for cylinder head covers and radiator end tanks.</skos:example>
        <co:PMD_0050117>PA66</co:PMD_0050117>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000011 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000011">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000577"/>
        <rdfs:comment xml:lang="en">The addition of 25% glass fiber significantly increases stiffness and tensile strength compared to neat PA66.</rdfs:comment>
        <rdfs:label xml:lang="en">polyamide 66 glass fiber 25 percent</rdfs:label>
        <skos:altLabel xml:lang="en">PA66-GF25</skos:altLabel>
        <skos:definition xml:lang="en">A composite material that has a polyamide 66 matrix and nominally 25 percent glass fiber by mass.</skos:definition>
        <skos:example xml:lang="en">Structural components in the engine bay requiring high stiffness at elevated temperatures.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000012 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000012">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000891"/>
        <rdfs:comment xml:lang="en">In PMD logic, this is a disconnected aggregate because the individual filaments in a bundle are distinct objects.</rdfs:comment>
        <rdfs:label xml:lang="en">fiber</rdfs:label>
        <skos:definition xml:lang="en">A disconnected material entity aggregate composed of elongated filament-like material parts.</skos:definition>
        <skos:example xml:lang="en">Carbon fiber tow, Aramid fibers.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000013 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000013">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0000012"/>
        <rdfs:comment xml:lang="en">Used extensively as a reinforcement agent in polymer matrix composites.</rdfs:comment>
        <rdfs:label xml:lang="en">glass fiber</rdfs:label>
        <skos:definition xml:lang="en">A fiber composed primarily of glass.</skos:definition>
        <skos:example xml:lang="en">E-Glass used to reinforce PA66 for automotive pedals.</skos:example>
        <co:PMD_0050117>GF</co:PMD_0050117>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000014 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000014">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020102"/>
        <rdfs:comment xml:lang="en">Commonly denoted as wt%. PA66-GF25 implies a value of 0.25 or 25%.</rdfs:comment>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: %.</rdfs:comment>
        <rdfs:label xml:lang="en">fiber material content mass fraction</rdfs:label>
        <skos:definition xml:lang="en">A mass proportion that quantifies fiber reinforcement mass relative to total composite material mass.</skos:definition>
        <skos:example xml:lang="en">25% mass fraction in PA66-GF25.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000015 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000015">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020104"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: %.</rdfs:comment>
        <rdfs:comment xml:lang="en">Volume fraction is more critical for micromechanical modeling (e.g., Rule of Mixtures) than mass fraction.</rdfs:comment>
        <rdfs:label xml:lang="en">fiber material content volume fraction</rdfs:label>
        <skos:altLabel xml:lang="en">volume fraction of fibers</skos:altLabel>
        <skos:definition xml:lang="en">A volume proportion that quantifies fiber reinforcement volume relative to total composite material volume.</skos:definition>
        <skos:example xml:lang="en">Approximately 14-15% volume fraction corresponds to 25% mass fraction for Glass/PA66.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000016 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:string; expected unit: not specified.</rdfs:comment>
        <rdfs:label xml:lang="en">identifier at manufacturer</rdfs:label>
        <skos:definition xml:lang="en">An identifier assigned by a manufacturer to a product, component, material grade, or material batch in its own system.</skos:definition>
        <skos:example xml:lang="en">A manufacturer code for a specific polymer grade.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000017 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:label xml:lang="en">identifier name at manufacturer</rdfs:label>
        <skos:definition xml:lang="en">An identifier that records the manufacturer name, brand name, or trade name used for a material or product.</skos:definition>
        <skos:example xml:lang="en">Zytel or Durethan used as a material trade name.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000018 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:string; expected unit: not specified.</rdfs:comment>
        <rdfs:label xml:lang="en">material designation</rdfs:label>
        <skos:definition xml:lang="en">An identifier that records a standard or supplier designation for a material composition.</skos:definition>
        <skos:example xml:lang="en">PA66-GF25</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000019 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:string; expected unit: not specified.</rdfs:comment>
        <rdfs:label xml:lang="en">material identifier</rdfs:label>
        <skos:definition xml:lang="en">An identifier assigned to a material entity, material batch, material grade, or material data record.</skos:definition>
        <skos:example xml:lang="en">A material twin identifier used in data exchange.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000020 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000020">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/log/LOG_0080002"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:string; expected unit: not specified.</rdfs:comment>
        <rdfs:label xml:lang="en">material batch identifier</rdfs:label>
        <skos:definition xml:lang="en">A batch identifier assigned to a material batch for traceability.</skos:definition>
        <skos:example xml:lang="en">Batch 2023-10-A-X55.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000021 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:string; expected unit: not specified.</rdfs:comment>
        <rdfs:label xml:lang="en">business partner number</rdfs:label>
        <skos:definition xml:lang="en">An identifier assigned to a business partner in an automotive supply-chain network.</skos:definition>
        <skos:example xml:lang="en">BPNL00000003AY2 (Example BPN).</skos:example>
        <co:PMD_0050117>BPN</co:PMD_0050117>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000022 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000022">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000848"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: not specified.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates ductility. Low strain at break (less than 5%) suggests brittle behavior.</rdfs:comment>
        <rdfs:label xml:lang="en">strain at break</rdfs:label>
        <skos:definition xml:lang="en">A mechanical property that quantifies specimen strain at rupture.</skos:definition>
        <skos:example xml:lang="en">3% strain at break for a glass-filled polyamide.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000023 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000023">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020131"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: Pa.s.</rdfs:comment>
        <rdfs:comment xml:lang="en">Used in injection molding simulations to predict mold filling.</rdfs:comment>
        <rdfs:label xml:lang="en">viscosity</rdfs:label>
        <skos:definition xml:lang="en">An intensive quality that quantifies a fluid material&apos;s resistance to flow.</skos:definition>
        <skos:example xml:lang="en">The melt viscosity of polypropylene at 230 degC.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000025 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000025">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0000023"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: Pa.s.</rdfs:comment>
        <rdfs:comment xml:lang="en">Polymers are non-Newtonian; their shear viscosity decreases as shear rate increases (shear thinning).</rdfs:comment>
        <rdfs:label xml:lang="en">shear viscosity</rdfs:label>
        <skos:definition xml:lang="en">A viscosity that quantifies resistance to flow under shear deformation.</skos:definition>
        <skos:example xml:lang="en">Viscosity curve data required for Moldflow simulation.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000026 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000026">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000882"/>
        <rdfs:comment xml:lang="en">Below Tg, the amorphous phase is frozen; above Tg, polymer chains have mobility.</rdfs:comment>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: degC.</rdfs:comment>
        <rdfs:label xml:lang="en">glass transition temperature</rdfs:label>
        <skos:definition xml:lang="en">A phase boundary temperature at which the amorphous phase of a polymer changes between glassy and rubbery states.</skos:definition>
        <skos:example xml:lang="en">A glass transition temperature of about 50 degC for dry PA66.</skos:example>
        <co:PMD_0050117>Tg</co:PMD_0050117>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000027 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000027">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000981"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: 1/K.</rdfs:comment>
        <rdfs:comment xml:lang="en">Used to calculate dimensional change in assemblies that combine materials with different thermal expansion behavior.</rdfs:comment>
        <rdfs:label xml:lang="en">coefficient of linear thermal expansion</rdfs:label>
        <skos:altLabel xml:lang="en">linear thermal expansion coefficient</skos:altLabel>
        <skos:definition xml:lang="en">A thermal property that quantifies fractional length change per unit temperature change.</skos:definition>
        <skos:example xml:lang="en">CLTE measured parallel and normal to fiber orientation in a reinforced polymer part.</skos:example>
        <co:PMD_0050117>CLTE</co:PMD_0050117>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000028 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000028">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000777"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: J kg^-1 K^-1.</rdfs:comment>
        <rdfs:comment xml:lang="en">Used to calculate cooling times in injection molding.</rdfs:comment>
        <rdfs:label xml:lang="en">specific heat capacity</rdfs:label>
        <skos:definition xml:lang="en">A heat capacity that quantifies heat required to raise the temperature of unit mass of a substance by one temperature unit.</skos:definition>
        <skos:example xml:lang="en">A specific heat capacity of 1700 J kg^-1 K^-1 for polypropylene.</skos:example>
        <co:PMD_0050117>Cp</co:PMD_0050117>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000029 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000029">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000952"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: kJ/m^2.</rdfs:comment>
        <rdfs:comment xml:lang="en">Often measured via Charpy or Izod notched impact tests.</rdfs:comment>
        <rdfs:label xml:lang="en">impact strength</rdfs:label>
        <skos:definition xml:lang="en">A strength that quantifies material resistance to fracture under impact loading.</skos:definition>
        <skos:example xml:lang="en">45 kJ/m^2 notched impact strength for a bumper material.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000030 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000030">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000949"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: MPa / GPa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Standard metric for stiffness in plastics (ISO 178).</rdfs:comment>
        <rdfs:label xml:lang="en">flexural modulus</rdfs:label>
        <skos:definition xml:lang="en">A stiffness that quantifies the ratio of flexural stress to flexural strain.</skos:definition>
        <skos:example xml:lang="en">Flexural modulus of 8500 MPa for PA66-GF30.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000031 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000031">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000952"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: MPa / GPa.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relevant for snap-fit joints in automotive interiors.</rdfs:comment>
        <rdfs:label xml:lang="en">flexural strength</rdfs:label>
        <skos:definition xml:lang="en">A strength that quantifies maximum stress under flexural loading before yielding or rupture.</skos:definition>
        <skos:example xml:lang="en">250 MPa for a high-performance composite.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0000032 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0000032">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020131"/>
        <rdfs:comment xml:lang="en">Relevant for polyamides because moisture uptake changes mechanical properties.</rdfs:comment>
        <rdfs:label xml:lang="en">humidity</rdfs:label>
        <skos:definition xml:lang="en">An intensive quality that quantifies water vapor content in air surrounding a material.</skos:definition>
        <skos:example xml:lang="en">50% Relative Humidity (standard conditioning atmosphere).</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010000 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010000">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/log/LOG_1000102"/>
        <rdfs:comment xml:lang="en">Whether a material is raw material depends on its participation in a particular production or recycling workflow.</rdfs:comment>
        <rdfs:label xml:lang="en">raw material feedstock</rdfs:label>
        <skos:definition xml:lang="en">A material entity that is intended to be consumed, transformed, or incorporated as input in a manufacturing, recycling, or material processing process.</skos:definition>
        <skos:example xml:lang="en">PA66 pellets supplied to an injection molding process as input material.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010001 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010001">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000002"/>
        <rdfs:comment xml:lang="en">This class represents the additive material itself; the context-dependent function is represented by additive role.</rdfs:comment>
        <rdfs:label xml:lang="en">additive</rdfs:label>
        <skos:definition xml:lang="en">An engineered material intentionally incorporated in a base material in a comparatively small amount to modify processing behavior, performance properties, appearance, or cost.</skos:definition>
        <skos:example xml:lang="en">A UV stabilizer added to an exterior polymer trim material.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010002 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010002">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000002"/>
        <rdfs:comment xml:lang="en">The corresponding realizable entity is PMD Core matrix role; this class is used for material entities considered as the continuous phase of a composite.</rdfs:comment>
        <rdfs:label xml:lang="en">matrix</rdfs:label>
        <skos:definition xml:lang="en">An engineered material that forms the continuous phase of a composite material and binds or embeds reinforcement, filler, or dispersed material constituents.</skos:definition>
        <skos:example xml:lang="en">The PA66 phase in a PA66-GF25 composite.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010003 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010003">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000005"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: %.</rdfs:comment>
        <rdfs:comment xml:lang="en">Values are normally reported for specified test conditions, such as ISO 62 or a specified conditioning atmosphere.</rdfs:comment>
        <rdfs:label xml:lang="en">water absorption</rdfs:label>
        <skos:definition xml:lang="en">A disposition of a material to take up water from a liquid water or humid environment under specified exposure conditions.</skos:definition>
        <skos:example xml:lang="en">The percentage mass increase of a polyamide specimen after immersion in water.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010004 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">materials information</rdfs:label>
        <skos:altLabel xml:lang="en">material data</skos:altLabel>
        <skos:altLabel xml:lang="en">material information</skos:altLabel>
        <skos:definition xml:lang="en">An information content entity that specifies material-related characteristics of a product, component, material batch, or material grade.</skos:definition>
        <skos:example xml:lang="en">A data record listing material designation, density, fiber content, and recycled content for an automotive component.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010005 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010005">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0025001"/>
        <rdfs:label xml:lang="en">material composition</rdfs:label>
        <skos:altLabel xml:lang="en">materials</skos:altLabel>
        <skos:definition xml:lang="en">A composition that describes the material constituents and constituent amounts of a product, component, material batch, or material grade.</skos:definition>
        <skos:example xml:lang="en">A composition stating that PA66-GF25 contains a PA66 matrix and nominally 25 percent glass fiber by mass.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010006 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010006">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000000"/>
        <rdfs:comment xml:lang="en">This class covers material entities whose origin is a recycling process; the amount or share of recycled content should be represented separately.</rdfs:comment>
        <rdfs:label xml:lang="en">recycled material</rdfs:label>
        <skos:definition xml:lang="en">A material entity that has been recovered from waste, discarded products, by-products, or production residues through a recycling process for subsequent use.</skos:definition>
        <skos:example xml:lang="en">Regranulated polypropylene produced from end-of-life vehicle parts.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010007 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:comment xml:lang="en">Use for the origin state of a material; use recycled material share for quantities or proportions.</rdfs:comment>
        <rdfs:label xml:lang="en">recycled</rdfs:label>
        <skos:definition xml:lang="en">A quality of a material entity indicating that the material has an origin in a recycling process rather than only in primary material production.</skos:definition>
        <skos:example xml:lang="en">A recycled quality borne by a polymer regrind used in a new injection molding batch.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010020 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">product footprint</rdfs:label>
        <skos:definition xml:lang="en">An information content entity that records an environmental footprint of a product over a stated scope.</skos:definition>
        <skos:example xml:lang="en">A product footprint report for an alternator covering cradle-to-gate carbon emissions and recycled material content.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010021 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000145"/>
        <rdfs:label xml:lang="en">recycled material share</rdfs:label>
        <skos:altLabel xml:lang="en">recycled share</skos:altLabel>
        <skos:definition xml:lang="en">A relational quality that relates a material, component, or product to the proportion of its material content that originates from recycled sources.</skos:definition>
        <skos:example xml:lang="en">A bumper fascia with 30 percent recycled polypropylene content.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010022 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001933"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010020"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: kg CO2e.</rdfs:comment>
        <rdfs:label xml:lang="en">product carbon footprint</rdfs:label>
        <skos:altLabel xml:lang="en">carbon footprint</skos:altLabel>
        <skos:altLabel xml:lang="en">carbon footprint amount</skos:altLabel>
        <skos:definition xml:lang="en">A product footprint that specifies greenhouse gas emissions associated with a product over a stated lifecycle scope.</skos:definition>
        <skos:example xml:lang="en">18.4 kg CO2e as the product carbon footprint for one steering system.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010023 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010023">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000008"/>
        <rdfs:label xml:lang="en">process footprint</rdfs:label>
        <skos:definition xml:lang="en">A process attribute that quantifies environmental burden associated with executing a process under specified boundary conditions.</skos:definition>
        <skos:example xml:lang="en">Electricity consumption and associated emissions for one injection molding cycle.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010024 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010024">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010023"/>
        <rdfs:label xml:lang="en">process carbon footprint</rdfs:label>
        <skos:definition xml:lang="en">A process footprint that quantifies greenhouse gas emissions associated with executing a process.</skos:definition>
        <skos:example xml:lang="en">The carbon footprint of recycling one kilogram of PA66-GF25 scrap.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010025 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010025">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020143"/>
        <rdfs:label xml:lang="en">lifecycle</rdfs:label>
        <skos:definition xml:lang="en">A process chain that comprises the stages through which a product or material passes from raw material acquisition through production, use, and end-of-life treatment.</skos:definition>
        <skos:example xml:lang="en">The lifecycle of an automotive control unit from material extraction to recycling.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010026 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:label xml:lang="en">lifecycle stage</rdfs:label>
        <skos:altLabel xml:lang="en">footprint lifecycle</skos:altLabel>
        <skos:definition xml:lang="en">A process that is a distinguishable part of a product or material lifecycle.</skos:definition>
        <skos:example xml:lang="en">Main product production as a lifecycle stage for an automotive component.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010027 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010027">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010026"/>
        <rdfs:label xml:lang="en">raw material acquisition</rdfs:label>
        <skos:definition xml:lang="en">A lifecycle stage in which natural resources, secondary materials, or basic feedstocks are obtained and prepared for production.</skos:definition>
        <skos:example xml:lang="en">Obtaining recycled polymer regranulate for later component production.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010028 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010028">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010026"/>
        <rdfs:label xml:lang="en">main product production</rdfs:label>
        <skos:definition xml:lang="en">A lifecycle stage in which raw materials, intermediate products, or components are transformed into the main product.</skos:definition>
        <skos:example xml:lang="en">Injection molding and assembly steps used to produce an automotive housing.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010029 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010029">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010026"/>
        <rdfs:label xml:lang="en">distribution</rdfs:label>
        <skos:definition xml:lang="en">A lifecycle stage in which products, components, or materials are transported, stored, or transferred between supply chain actors.</skos:definition>
        <skos:example xml:lang="en">Shipment of remanufactured components from a supplier to a vehicle manufacturer.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010030 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010030">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010026"/>
        <rdfs:label xml:lang="en">end of life</rdfs:label>
        <skos:definition xml:lang="en">A lifecycle stage in which a product or component has reached the end of its intended use and is directed to reuse, remanufacturing, recycling, recovery, or disposal.</skos:definition>
        <skos:example xml:lang="en">Removal of a component from an end-of-life vehicle for circular value assessment.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010031 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010031">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010026"/>
        <rdfs:label xml:lang="en">recycling lifecycle stage</rdfs:label>
        <skos:altLabel xml:lang="en">recycling</skos:altLabel>
        <skos:definition xml:lang="en">A lifecycle stage in which used materials or products are processed to recover material for further use.</skos:definition>
        <skos:example xml:lang="en">Grinding, sorting, and regranulating a polymer component after dismantling.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010033 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010033">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010022"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: kg CO2e.</rdfs:comment>
        <rdfs:label xml:lang="en">recycling carbon footprint</rdfs:label>
        <skos:altLabel xml:lang="en">footprint recycling</skos:altLabel>
        <skos:definition xml:lang="en">A product carbon footprint that specifies greenhouse gas emissions for a recycling scenario.</skos:definition>
        <skos:example xml:lang="en">12 kg CO2e attributed to recycling one dismantled bumper cover.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010034 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010034">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010022"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: kg CO2e.</rdfs:comment>
        <rdfs:label xml:lang="en">remanufacturing carbon footprint</rdfs:label>
        <skos:altLabel xml:lang="en">footprint remanufacturing</skos:altLabel>
        <skos:definition xml:lang="en">A product carbon footprint that specifies greenhouse gas emissions for a remanufacturing scenario.</skos:definition>
        <skos:example xml:lang="en">7.5 kg CO2e attributed to inspecting, repairing, and remanufacturing one alternator.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010035 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010035">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010022"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: kg CO2e.</rdfs:comment>
        <rdfs:label xml:lang="en">reuse carbon footprint</rdfs:label>
        <skos:altLabel xml:lang="en">footprint reuse</skos:altLabel>
        <skos:definition xml:lang="en">A product carbon footprint that specifies greenhouse gas emissions for a reuse scenario.</skos:definition>
        <skos:example xml:lang="en">2.1 kg CO2e attributed to checking and reusing one component.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010036 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010036">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010022"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: kg CO2e.</rdfs:comment>
        <rdfs:label xml:lang="en">new production carbon footprint</rdfs:label>
        <skos:altLabel xml:lang="en">footprint new production</skos:altLabel>
        <skos:definition xml:lang="en">A product carbon footprint that specifies greenhouse gas emissions for a new production scenario.</skos:definition>
        <skos:example xml:lang="en">24 kg CO2e attributed to manufacturing one replacement component from primary material.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010040 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010040">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000005"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: %.</rdfs:comment>
        <rdfs:label xml:lang="en">humidity absorption</rdfs:label>
        <skos:definition xml:lang="en">A disposition of a material or component to absorb water vapor from a humid environment under specified exposure conditions.</skos:definition>
        <skos:example xml:lang="en">Moisture uptake by a PA66 component during use at 50 percent relative humidity.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010050 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010050">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000202"/>
        <rdfs:label xml:lang="en">remaining lifetime</rdfs:label>
        <skos:definition xml:lang="en">A temporal interval expected to remain before a product or component no longer satisfies its intended function or circular value criteria.</skos:definition>
        <skos:example xml:lang="en">An alternator estimated to have 24 months of usable service life remaining after inspection.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010051 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010051">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000202"/>
        <rdfs:label xml:lang="en">actual lifetime</rdfs:label>
        <skos:definition xml:lang="en">A temporal interval extending from a stated start event to an observed lifecycle event of a product or component.</skos:definition>
        <skos:example xml:lang="en">The time between first vehicle registration and dismantling of a component.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010052 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010052">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
        <rdfs:label xml:lang="en">non-destructive dismantlability</rdfs:label>
        <skos:definition xml:lang="en">A disposition of a product or component to be dismantled without destroying the product, component, or material portions that are intended for later use.</skos:definition>
        <skos:example xml:lang="en">A clipped interior trim part that can be removed intact for reuse.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010053 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010053">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <rdfs:label xml:lang="en">safety information</rdfs:label>
        <skos:altLabel xml:lang="en">safetyInfo</skos:altLabel>
        <skos:definition xml:lang="en">A directive information entity that specifies safety-relevant instructions, warnings, or constraints for handling, dismantling, treating, transporting, or reusing a product or component.</skos:definition>
        <skos:example xml:lang="en">A warning to disconnect a high-voltage battery before dismantling a component.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010054 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010054">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:label xml:lang="en">recycling</rdfs:label>
        <skos:definition xml:lang="en">A process in which used materials, components, or products are collected and processed to recover material for further use.</skos:definition>
        <skos:example xml:lang="en">Sorting and regranulating polymer parts from an end-of-life vehicle.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010055 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010055">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:label xml:lang="en">dismantling</rdfs:label>
        <skos:definition xml:lang="en">A process in which a product or component is taken apart so that parts, materials, or information can be recovered, assessed, reused, repaired, remanufactured, recycled, or disposed.</skos:definition>
        <skos:example xml:lang="en">Removing a vehicle door module from an end-of-life vehicle before quality assessment.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010056 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010056">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <rdfs:label xml:lang="en">dismantling guideline for recycling</rdfs:label>
        <skos:altLabel xml:lang="en">dismantling guideline recycling</skos:altLabel>
        <skos:altLabel xml:lang="en">dismantlingGuidelineRecycling</skos:altLabel>
        <skos:definition xml:lang="en">A plan specification that provides instructions for dismantling a product or component so that materials can be routed to appropriate recycling treatment.</skos:definition>
        <skos:example xml:lang="en">A guideline specifying how to separate a polymer housing from attached metal inserts before recycling.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010057 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010057">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
        <rdfs:label xml:lang="en">recycling material quality</rdfs:label>
        <skos:altLabel xml:lang="en">recyclingMaterialQuality</skos:altLabel>
        <skos:definition xml:lang="en">A disposition of a product or material to be recycled while preserving a specified level of material quality.</skos:definition>
        <skos:example xml:lang="en">A polymer component designed so that the recovered polymer remains suitable for automotive applications.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010058 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010058">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
        <rdfs:label xml:lang="en">recycling availability</rdfs:label>
        <skos:altLabel xml:lang="en">recyclingAvailability</skos:altLabel>
        <skos:definition xml:lang="en">A disposition of a product, component, or material to be practically available for recycling in a technical cycle.</skos:definition>
        <skos:example xml:lang="en">A component whose material can be separated and accepted by an established recycling route.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010059 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010059">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <rdfs:label xml:lang="en">dismantling instructions</rdfs:label>
        <skos:altLabel xml:lang="en">dismantlingInstructions</skos:altLabel>
        <skos:definition xml:lang="en">A plan specification that describes the actions, order, tools, and constraints for safely and correctly dismantling a product or component.</skos:definition>
        <skos:example xml:lang="en">Stepwise instructions for removing a battery module from a vehicle.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010060 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010060">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
        <rdfs:label xml:lang="en">dismantlability</rdfs:label>
        <skos:definition xml:lang="en">A disposition of a product or component to be dismantled under stated technical, safety, time, and damage constraints.</skos:definition>
        <skos:example xml:lang="en">A bolted assembly has higher dismantlability than an inseparably bonded assembly when reuse is intended.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010061 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010061">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000202"/>
        <rdfs:label xml:lang="en">average dismantling time</rdfs:label>
        <skos:altLabel xml:lang="en">averageDismantlingTime</skos:altLabel>
        <skos:definition xml:lang="en">A temporal interval that represents the mean duration of dismantling a product or component under specified conditions.</skos:definition>
        <skos:example xml:lang="en">An average dismantling time of 12 minutes for removal of a door module.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010062 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010062">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:label xml:lang="en">treatment technique</rdfs:label>
        <skos:altLabel xml:lang="en">treatmentTechnique</skos:altLabel>
        <skos:definition xml:lang="en">A process used to treat a dismantled component, product, or material after removal from its original assembly.</skos:definition>
        <skos:example xml:lang="en">Mechanical shredding, cleaning, or material separation applied after dismantling.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010063 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010063">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">best treatment techniques</rdfs:label>
        <skos:altLabel xml:lang="en">bestTreatmentTechniques</skos:altLabel>
        <skos:definition xml:lang="en">An information content entity that recommends preferred treatment techniques for a dismantled product, component, or material in a given circular economy scenario.</skos:definition>
        <skos:example xml:lang="en">A recommendation to remove electronics before shredding a polymer-rich component.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010064 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010064">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000010"/>
        <rdfs:label xml:lang="en">disassembly software</rdfs:label>
        <skos:definition xml:lang="en">A software that supports, guides, documents, or validates disassembly or dismantling of a product or component.</skos:definition>
        <skos:example xml:lang="en">A workshop application that displays product-specific disassembly instructions.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010065 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010065">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000602"/>
        <rdfs:label xml:lang="en">disassembly tool</rdfs:label>
        <skos:definition xml:lang="en">A device used to carry out a disassembly or dismantling operation on a product or component.</skos:definition>
        <skos:example xml:lang="en">A puller tool used to remove a clipped trim component without damage.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010066 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010066">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <rdfs:label xml:lang="en">fastening technique</rdfs:label>
        <skos:definition xml:lang="en">A plan specification that describes how parts are joined, fixed, or released in an assembly.</skos:definition>
        <skos:example xml:lang="en">A specification that a housing is fastened with Torx screws and snap-fit clips.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010067 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010067">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <rdfs:label xml:lang="en">dismantling sequence</rdfs:label>
        <skos:definition xml:lang="en">A plan specification that orders the steps required to dismantle a product or component.</skos:definition>
        <skos:example xml:lang="en">Remove cover, disconnect cable, release clips, and lift out module.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010068 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010068">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000310"/>
        <rdfs:label xml:lang="en">exploding diagram</rdfs:label>
        <skos:definition xml:lang="en">A document or figure that depicts a product or assembly with parts spatially separated to show their relative positions and dismantling relationships.</skos:definition>
        <skos:example xml:lang="en">An exploded-view diagram showing screws, clips, housing shells, and subcomponents of a control unit.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010069 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010069">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:label xml:lang="en">sub-group name</rdfs:label>
        <skos:definition xml:lang="en">An identifier that records the name of a material sub-group in a material classification scheme.</skos:definition>
        <skos:example xml:lang="en">The VDA 231-106 sub-group name &apos;cast aluminium alloys&apos;.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010070 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010070">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:label xml:lang="en">sub-group identifier</rdfs:label>
        <skos:altLabel xml:lang="en">sub-group ID</skos:altLabel>
        <skos:altLabel xml:lang="en">subgroup</skos:altLabel>
        <skos:definition xml:lang="en">An identifier that records the code or number of a material sub-group in a material classification scheme.</skos:definition>
        <skos:example xml:lang="en">The VDA 231-106 sub-group code &apos;2.1.1&apos;.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010071 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010071">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:label xml:lang="en">main group name</rdfs:label>
        <skos:definition xml:lang="en">An identifier that records the name of a material main group in a material classification scheme.</skos:definition>
        <skos:example xml:lang="en">The VDA 231-106 main group name &apos;polymer materials&apos;.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010072 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010072">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:label xml:lang="en">main group identifier</rdfs:label>
        <skos:altLabel xml:lang="en">main group</skos:altLabel>
        <skos:altLabel xml:lang="en">main group ID</skos:altLabel>
        <skos:definition xml:lang="en">An identifier that records the code or number of a material main group in a material classification scheme.</skos:definition>
        <skos:example xml:lang="en">The VDA 231-106 main group code &apos;5&apos;.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010073 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010073">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:label xml:lang="en">reuse</rdfs:label>
        <skos:definition xml:lang="en">A process in which a discarded or removed product or component is used again while retaining its original function.</skos:definition>
        <skos:example xml:lang="en">A dismantled and inspected body control module installed in another vehicle.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010074 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010074">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
        <rdfs:label xml:lang="en">product quality</rdfs:label>
        <skos:definition xml:lang="en">A disposition of a product or component to satisfy requirements for an intended circular economy route, based on relevant condition, completeness, functional, and standard-based criteria.</skos:definition>
        <skos:example xml:lang="en">A reused body part assigned a quality class after inspection for dents, corrosion, paint damage, and completeness.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010075 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010075">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">test requirements</rdfs:label>
        <skos:altLabel xml:lang="en">necessary test protocols and equipment</skos:altLabel>
        <skos:altLabel xml:lang="en">necessary test protocols equipment</skos:altLabel>
        <skos:definition xml:lang="en">An information content entity that states the test protocols and equipment required to assess a product or component for reuse, repair, remanufacturing, or recycling.</skos:definition>
        <skos:example xml:lang="en">A high-voltage component requiring insulation resistance testing before reuse.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010076 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010076">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
        <rdfs:label xml:lang="en">reusability</rdfs:label>
        <skos:definition xml:lang="en">A disposition of a product or component to be reused in its original function under stated technical, legal, safety, and quality constraints.</skos:definition>
        <skos:example xml:lang="en">A complete undamaged headlamp assembly that can be installed as a replacement part.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010077 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010077">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:label xml:lang="en">body part quality</rdfs:label>
        <skos:altLabel xml:lang="en">component quality state</skos:altLabel>
        <skos:altLabel xml:lang="en">quality body parts</skos:altLabel>
        <skos:definition xml:lang="en">A quality of a body part component that characterizes its externally relevant condition, such as paint damage, dents, corrosion, and component-specific defects.</skos:definition>
        <skos:example xml:lang="en">A door panel quality assessment based on dents and paint scratches.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010078 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010078">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:label xml:lang="en">quality grade</rdfs:label>
        <skos:altLabel xml:lang="en">qualityGrade</skos:altLabel>
        <skos:definition xml:lang="en">A quality that records the grade assigned to a product or component according to a stated quality standard or assessment scheme.</skos:definition>
        <skos:example xml:lang="en">A, B, or C quality grade assigned to a used car part.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010079 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010079">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:label xml:lang="en">completeness</rdfs:label>
        <skos:definition xml:lang="en">A quality of a product or component indicating whether required subcomponents, fasteners, interfaces, or accessories are present.</skos:definition>
        <skos:example xml:lang="en">A mirror assembly assessed as complete because housing, glass, wiring, and mounting clips are present.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010080 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010080">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <rdfs:label xml:lang="en">used quality standard</rdfs:label>
        <skos:altLabel xml:lang="en">usedQualityStandard</skos:altLabel>
        <skos:definition xml:lang="en">A plan specification that defines the quality assessment criteria applied to a reused, repaired, remanufactured, or recycled product or component.</skos:definition>
        <skos:example xml:lang="en">VDI 4080 used as the assessment standard for reuse quality.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010081 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010081">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:label xml:lang="en">mounting point integrity</rdfs:label>
        <skos:altLabel xml:lang="en">mountingPointIntegrity</skos:altLabel>
        <skos:definition xml:lang="en">A quality of a product or component indicating whether its mounting points, clips, tabs, or attachment features are intact and functional.</skos:definition>
        <skos:example xml:lang="en">A bumper bracket with all mounting tabs undamaged.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010082 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010082">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:label xml:lang="en">surface cleanliness</rdfs:label>
        <skos:altLabel xml:lang="en">surfaceCleanliness</skos:altLabel>
        <skos:definition xml:lang="en">A quality of a product, component, or material surface indicating the degree to which it is free from oil, dust, residues, and other contaminants.</skos:definition>
        <skos:example xml:lang="en">A cleaned polymer surface acceptable for adhesive bonding during reuse preparation.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010083 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010083">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000202"/>
        <rdfs:label xml:lang="en">repair time</rdfs:label>
        <skos:altLabel xml:lang="en">repairTime</skos:altLabel>
        <skos:definition xml:lang="en">A temporal interval required or estimated to repair a specified damage or defect on a product or component.</skos:definition>
        <skos:example xml:lang="en">The time needed to repair a paint scratch and small dent on a door panel.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010084 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010084">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:label xml:lang="en">crack count</rdfs:label>
        <skos:altLabel xml:lang="en">(number of paint) cracks</skos:altLabel>
        <skos:altLabel xml:lang="en">cracks</skos:altLabel>
        <skos:definition xml:lang="en">A quality that records the number of cracks observed on a product, component, coating, or material surface.</skos:definition>
        <skos:example xml:lang="en">Two cracks recorded in the paint layer during dismantling inspection.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010085 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010085">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:label xml:lang="en">dent damage</rdfs:label>
        <skos:altLabel xml:lang="en">dents</skos:altLabel>
        <skos:definition xml:lang="en">A quality of a sheet metal or body component indicating the presence or extent of dents or deformations that impair the component shape.</skos:definition>
        <skos:example xml:lang="en">A quarter panel with two visible dents after vehicle use.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010086 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010086">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:label xml:lang="en">damage area</rdfs:label>
        <skos:altLabel xml:lang="en">damageArea</skos:altLabel>
        <skos:definition xml:lang="en">A quality that quantifies the surface area of visible damage on a product, component, coating, or material surface.</skos:definition>
        <skos:example xml:lang="en">A paint damage area of 50 square centimeters on a door panel.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010087 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010087">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:label xml:lang="en">paint damage</rdfs:label>
        <skos:altLabel xml:lang="en">paintDamage</skos:altLabel>
        <skos:definition xml:lang="en">A quality of a painted product or component indicating damage to the paintwork, such as scratches, chips, cracks, or coating loss.</skos:definition>
        <skos:example xml:lang="en">Stone-chip damage on a painted bumper cover.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010090 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010090">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:label xml:lang="en">manufacturer name</rdfs:label>
        <skos:definition xml:lang="en">An identifier that records the name by which a manufacturer is referred to in a data exchange, contract, product record, or manufacturer system.</skos:definition>
        <skos:example xml:lang="en">The manufacturer name &apos;Schaeffler&apos; in a supplier record.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010091 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010091">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
        <rdfs:label xml:lang="en">manufacturer plant site</rdfs:label>
        <skos:altLabel xml:lang="en">manufacturer plant/site</skos:altLabel>
        <skos:definition xml:lang="en">A site at which a manufacturer carries out production, assembly, treatment, storage, or related industrial operations.</skos:definition>
        <skos:example xml:lang="en">A specific plant where a material batch or component was produced.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010092 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010092">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0000021"/>
        <rdfs:comment xml:lang="en">This is modeled as a Catena-X-specific subtype of the existing business partner number class.</rdfs:comment>
        <rdfs:label xml:lang="en">catena-x business partner number</rdfs:label>
        <skos:altLabel xml:lang="en">CX business partner number</skos:altLabel>
        <skos:definition xml:lang="en">A business partner number used in Catena-X to identify a legal entity, site, or address participating in automotive data exchange.</skos:definition>
        <skos:example xml:lang="en">A Catena-X BPNL identifier for a supplier legal entity.</skos:example>
        <co:PMD_0050117>BPN</co:PMD_0050117>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010093 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010093">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/log/LOG_0080001"/>
        <rdfs:label xml:lang="en">vehicle identification number</rdfs:label>
        <skos:altLabel xml:lang="en">VIN</skos:altLabel>
        <skos:altLabel xml:lang="en">vehicle identification number</skos:altLabel>
        <skos:definition xml:lang="en">An identifier assigned to an individual vehicle according to a vehicle identification number scheme.</skos:definition>
        <skos:example xml:lang="en">A 17-character vehicle identification number used in a dismantling record.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010094 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010094">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:label xml:lang="en">vehicle model</rdfs:label>
        <skos:altLabel xml:lang="en">vehicle model (Fahrzeugmodell)</skos:altLabel>
        <skos:definition xml:lang="en">An identifier that records the model designation of a vehicle type as defined by a manufacturer.</skos:definition>
        <skos:example xml:lang="en">A manufacturer-specific vehicle model name used in a product data record.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010095 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010095">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">component information</rdfs:label>
        <skos:altLabel xml:lang="en">component information (Bauteilinformationen)</skos:altLabel>
        <skos:definition xml:lang="en">An information content entity that aggregates identifiers, specifications, usage data, condition data, or circular economy information about a component.</skos:definition>
        <skos:example xml:lang="en">A component record containing part number, material designation, mileage, and reuse assessment.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010096 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010096">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000008"/>
        <rdfs:label xml:lang="en">component mileage</rdfs:label>
        <skos:altLabel xml:lang="en">mileage of the component</skos:altLabel>
        <skos:altLabel xml:lang="en">mileage of the component (Laufleistung der Komponente)</skos:altLabel>
        <skos:definition xml:lang="en">A process attribute that quantifies the travel distance accumulated by a component during use in a vehicle.</skos:definition>
        <skos:example xml:lang="en">A used alternator recorded with 125000 km of component mileage.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010097 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010097">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000202"/>
        <rdfs:label xml:lang="en">component age</rdfs:label>
        <skos:altLabel xml:lang="en">component age (Alter der Komponente)</skos:altLabel>
        <skos:definition xml:lang="en">A temporal interval that extends from a stated component reference event to a stated observation event.</skos:definition>
        <skos:example xml:lang="en">A component age of six years measured from vehicle production date to dismantling date.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010098 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010098">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0001044"/>
        <rdfs:label xml:lang="en">year of construction</rdfs:label>
        <skos:altLabel xml:lang="en">year of construction (Baujahr)</skos:altLabel>
        <skos:definition xml:lang="en">A date value specification that records the calendar year in which a product, component, vehicle, or facility was constructed or manufactured.</skos:definition>
        <skos:example xml:lang="en">The year 2019 recorded as the construction year of a vehicle.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010100 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010100">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:label xml:lang="en">environmental condition</rdfs:label>
        <skos:definition xml:lang="en">A quality of an environment that is relevant to material behavior, processing, testing, storage, use, or degradation.</skos:definition>
        <skos:example xml:lang="en">A conditioning atmosphere with specified temperature and relative humidity.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010101 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010101">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000002"/>
        <rdfs:comment xml:lang="en">The role borne by such a material in a composite is PMD Core filler role.</rdfs:comment>
        <rdfs:label xml:lang="en">filler</rdfs:label>
        <skos:altLabel xml:lang="en">fillers</skos:altLabel>
        <skos:definition xml:lang="en">An engineered material incorporated in another material to occupy volume, modify properties, reduce cost, or contribute reinforcement in a composite or compound.</skos:definition>
        <skos:example xml:lang="en">Glass fibers or mineral particles added to a polymer compound.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010102 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010102">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010101"/>
        <rdfs:comment xml:lang="en">The Excel hint to PMD Core filler role was modeled as a material class here because the glossary term names the reinforcing material, not only the role.</rdfs:comment>
        <rdfs:label xml:lang="en">reinforcement</rdfs:label>
        <skos:definition xml:lang="en">A filler material that is incorporated into a matrix material to improve load-bearing, stiffness, strength, impact, or dimensional performance.</skos:definition>
        <skos:example xml:lang="en">Chopped glass fiber used as reinforcement in PA66-GF25.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010103 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010103">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <rdfs:label xml:lang="en">further content</rdfs:label>
        <skos:definition xml:lang="en">A composition data item that records additional material constituents or content fractions not captured by the primary material composition fields.</skos:definition>
        <skos:example xml:lang="en">A data item recording minor additive content in a polymer compound.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010104 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010104">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020102"/>
        <rdfs:comment xml:lang="en">The Excel source references ISO 15512 for plastics water content measurement.</rdfs:comment>
        <rdfs:label xml:lang="en">water content</rdfs:label>
        <skos:altLabel xml:lang="en">water content (in alignment with ISO 15512)</skos:altLabel>
        <skos:definition xml:lang="en">A mass proportion that quantifies the amount of water contained in a material under specified measurement or conditioning conditions.</skos:definition>
        <skos:example xml:lang="en">Water content of a polyamide granulate measured before injection molding.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010105 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010105">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020102"/>
        <rdfs:comment xml:lang="en">The Excel source references ISO 3451 for ash content, often used to estimate inorganic filler content.</rdfs:comment>
        <rdfs:label xml:lang="en">ash content</rdfs:label>
        <skos:altLabel xml:lang="en">ash content (Fuellstoffgehalt, ISO 3451)</skos:altLabel>
        <skos:definition xml:lang="en">A mass proportion that quantifies the inorganic residue remaining after controlled combustion or calcination of a material sample.</skos:definition>
        <skos:example xml:lang="en">Ash content used to estimate glass fiber or mineral filler content in a polymer compound.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010106 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010106">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:string; expected unit: not specified.</rdfs:comment>
        <rdfs:label xml:lang="en">material class</rdfs:label>
        <skos:altLabel xml:lang="en">MaterialClass</skos:altLabel>
        <skos:altLabel xml:lang="en">material class and composition</skos:altLabel>
        <skos:definition xml:lang="en">An information content entity that assigns a material, component, or product to a material category in a stated classification scheme.</skos:definition>
        <skos:example xml:lang="en">A VDA 231-106 material class assignment for polymer materials.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010107 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010107">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:label xml:lang="en">material abbreviation</rdfs:label>
        <skos:definition xml:lang="en">An identifier that records a short material designation or abbreviation used for a material or material family.</skos:definition>
        <skos:example xml:lang="en">PA66-GF25 as an abbreviated designation for a glass-fiber-reinforced polyamide 66 compound.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010108 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010108">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000933"/>
        <rdfs:label xml:lang="en">manufacturing simulation</rdfs:label>
        <skos:definition xml:lang="en">A simulation process that represents a manufacturing process and its material, process, geometry, or performance consequences.</skos:definition>
        <skos:example xml:lang="en">A simulation of an injection molding process used to predict filling and cooling behavior.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010109 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010109">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010108"/>
        <rdfs:label xml:lang="en">injection molding simulation</rdfs:label>
        <skos:altLabel xml:lang="en">injection modling entity</skos:altLabel>
        <skos:definition xml:lang="en">A manufacturing simulation that represents an injection molding process, including relevant material, mold, filling, packing, cooling, or warpage behavior.</skos:definition>
        <skos:example xml:lang="en">A mold-filling simulation for a PA66-GF25 housing.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010110 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010110">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000933"/>
        <rdfs:label xml:lang="en">quasistatic simulation</rdfs:label>
        <skos:altLabel xml:lang="en">quasi static entity</skos:altLabel>
        <skos:altLabel xml:lang="en">quasi static simulation</skos:altLabel>
        <skos:definition xml:lang="en">A simulation process that represents material or component response under loading conditions where inertial effects are negligible.</skos:definition>
        <skos:example xml:lang="en">A quasistatic finite element simulation of a bracket under service load.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010111 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010111">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000933"/>
        <rdfs:label xml:lang="en">thermal simulation</rdfs:label>
        <skos:altLabel xml:lang="en">thermal expansion coefficient entity</skos:altLabel>
        <skos:definition xml:lang="en">A simulation process that represents heat transfer, temperature distribution, or thermally induced material behavior.</skos:definition>
        <skos:example xml:lang="en">A cooling simulation for an injection molded component.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010112 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010112">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000952"/>
        <rdfs:label xml:lang="en">quasistatic stress normal</rdfs:label>
        <skos:altLabel xml:lang="en">normal parameter quasi static stress</skos:altLabel>
        <skos:definition xml:lang="en">A strength-related material or simulation output quality that represents stress normal to a reference direction under quasistatic loading.</skos:definition>
        <skos:example xml:lang="en">Normal stress predicted by a quasistatic simulation perpendicular to fiber orientation.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010113 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010113">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000952"/>
        <rdfs:label xml:lang="en">quasistatic stress parallel</rdfs:label>
        <skos:altLabel xml:lang="en">parallel parameter quasi static stress</skos:altLabel>
        <skos:definition xml:lang="en">A strength-related material or simulation output quality that represents stress parallel to a reference direction under quasistatic loading.</skos:definition>
        <skos:example xml:lang="en">Stress predicted parallel to fiber orientation in a quasistatic simulation.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010114 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010114">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000848"/>
        <rdfs:label xml:lang="en">quasistatic strain normal</rdfs:label>
        <skos:altLabel xml:lang="en">normal parameter quasi static strain</skos:altLabel>
        <skos:definition xml:lang="en">A mechanical property or simulation output quality that represents strain normal to a reference direction under quasistatic loading.</skos:definition>
        <skos:example xml:lang="en">Normal strain predicted perpendicular to fiber orientation in a quasistatic simulation.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010115 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010115">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000848"/>
        <rdfs:label xml:lang="en">quasistatic strain parallel</rdfs:label>
        <skos:altLabel xml:lang="en">parallel parameter quasi static strain</skos:altLabel>
        <skos:definition xml:lang="en">A mechanical property or simulation output quality that represents strain parallel to a reference direction under quasistatic loading.</skos:definition>
        <skos:example xml:lang="en">Strain predicted parallel to fiber orientation in a quasistatic simulation.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010116 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010116">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0040001"/>
        <rdfs:label xml:lang="en">elongation expansion normal</rdfs:label>
        <skos:altLabel xml:lang="en">elongation/expansion normal</skos:altLabel>
        <skos:definition xml:lang="en">A length-related quality or simulation output that represents elongation or expansion normal to a reference direction.</skos:definition>
        <skos:example xml:lang="en">Thermal expansion normal to fiber orientation in a molded composite.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010117 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010117">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0040001"/>
        <rdfs:label xml:lang="en">elongation expansion parallel</rdfs:label>
        <skos:altLabel xml:lang="en">elongation/expansion parallel</skos:altLabel>
        <skos:definition xml:lang="en">A length-related quality or simulation output that represents elongation or expansion parallel to a reference direction.</skos:definition>
        <skos:example xml:lang="en">Thermal expansion parallel to fiber orientation in a molded composite.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010118 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010118">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0040001"/>
        <rdfs:label xml:lang="en">length of fibers</rdfs:label>
        <skos:definition xml:lang="en">A length quality that quantifies the characteristic or measured length of fibers in a fiber-containing material.</skos:definition>
        <skos:example xml:lang="en">Mean glass fiber length after injection molding of PA66-GF25.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010119 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010119">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020102"/>
        <rdfs:label xml:lang="en">reutilization material share</rdfs:label>
        <skos:definition xml:lang="en">A mass proportion that quantifies the share of material from rework, regrind, or scrap that is reused within the process or production system that generated it.</skos:definition>
        <skos:example xml:lang="en">The percentage of in-process regrind returned to an injection molding feedstock.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010120 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010120">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">origin</rdfs:label>
        <skos:definition xml:lang="en">An information content entity that records the source category, provenance, or supply-chain origin of a material.</skos:definition>
        <skos:example xml:lang="en">An origin statement that a polymer fraction is post-consumer automotive recycled material.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010121 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010121">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020102"/>
        <rdfs:label xml:lang="en">pre-consumer material share</rdfs:label>
        <skos:altLabel xml:lang="en">pre consumer shares</skos:altLabel>
        <skos:definition xml:lang="en">A mass proportion that quantifies material content originating from pre-consumer production residues, by-products, rework, or scrap.</skos:definition>
        <skos:example xml:lang="en">The share of molding scrap reused before the product reached a consumer.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010122 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010122">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020102"/>
        <rdfs:label xml:lang="en">post-consumer material share</rdfs:label>
        <skos:altLabel xml:lang="en">post consumer shares</skos:altLabel>
        <skos:definition xml:lang="en">A mass proportion that quantifies material content originating from products or materials recovered after consumer or user service.</skos:definition>
        <skos:example xml:lang="en">The share of polypropylene recovered from end-of-life vehicle parts.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010123 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010123">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020102"/>
        <rdfs:label xml:lang="en">material source share</rdfs:label>
        <skos:altLabel xml:lang="en">material source shares</skos:altLabel>
        <skos:definition xml:lang="en">A mass proportion that quantifies the share of material from a stated source category, such as primary, secondary, pre-consumer, post-consumer, automotive, or non-automotive sources.</skos:definition>
        <skos:example xml:lang="en">A material source share for secondary automotive recycled content.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010124 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010124">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000310"/>
        <rdfs:label xml:lang="en">other recycling information</rdfs:label>
        <skos:altLabel xml:lang="en">other information</skos:altLabel>
        <skos:definition xml:lang="en">A document or information content entity that provides additional evidence, provenance, compliance, or quality information about material origin or recycling.</skos:definition>
        <skos:example xml:lang="en">A supplier declaration documenting recycled material origin and quality.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010125 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010125">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020102"/>
        <rdfs:label xml:lang="en">automotive material share</rdfs:label>
        <skos:altLabel xml:lang="en">automotive</skos:altLabel>
        <skos:definition xml:lang="en">A mass proportion that quantifies the share of material content originating from automotive sources.</skos:definition>
        <skos:example xml:lang="en">The fraction of recycled polymer sourced from end-of-life vehicle components.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010126 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010126">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020102"/>
        <rdfs:label xml:lang="en">non-automotive material share</rdfs:label>
        <skos:altLabel xml:lang="en">non automotive</skos:altLabel>
        <skos:definition xml:lang="en">A mass proportion that quantifies the share of material content originating from non-automotive sources.</skos:definition>
        <skos:example xml:lang="en">The fraction of recycled polymer sourced from consumer packaging rather than vehicle components.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010127 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010127">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000000"/>
        <rdfs:label xml:lang="en">secondary material</rdfs:label>
        <skos:definition xml:lang="en">A material entity obtained from waste, by-products, production residues, or recovered products and intended to substitute for primary material in a production process.</skos:definition>
        <skos:example xml:lang="en">A recycled polymer regranulate used as feedstock for a new automotive component.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010128 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010128">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000000"/>
        <rdfs:label xml:lang="en">primary material</rdfs:label>
        <skos:definition xml:lang="en">A material entity produced from virgin raw resources and used for the first time in a production process.</skos:definition>
        <skos:example xml:lang="en">Virgin PA66 resin produced from primary chemical feedstocks.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010129 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010129">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0040001"/>
        <rdfs:label xml:lang="en">physical dimension</rdfs:label>
        <skos:definition xml:lang="en">A quality that characterizes a physical extent or dimensional feature of a material entity, product, component, or geometric feature.</skos:definition>
        <skos:example xml:lang="en">Length, width, thickness, or diameter used to characterize an automotive component.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010131 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010131">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000618"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: GPa.</rdfs:comment>
        <rdfs:label xml:lang="en">young&apos;s modulus</rdfs:label>
        <skos:altLabel xml:lang="en">youngs modulus</skos:altLabel>
        <skos:definition xml:lang="en">An elastic modulus that quantifies the ratio of uniaxial stress to uniaxial strain in the linear elastic region of a material response.</skos:definition>
        <skos:example xml:lang="en">9.5 GPa Young&apos;s modulus for PA66-GF30 measured by tensile testing.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010140 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010140">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <rdfs:label xml:lang="en">unusual properties</rdfs:label>
        <skos:definition xml:lang="en">A data item that records noteworthy, unexpected, or abnormal properties observed for a component during use, inspection, dismantling, or circular economy assessment.</skos:definition>
        <skos:example xml:lang="en">A note that a component shows unusual discoloration or deformation compared with its expected state.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010141 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010141">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000202"/>
        <rdfs:label xml:lang="en">actual dismantling time</rdfs:label>
        <skos:definition xml:lang="en">A temporal interval occupied by an observed dismantling process for a product, vehicle, or component.</skos:definition>
        <skos:example xml:lang="en">The measured time in minutes to remove a component from an end-of-life vehicle.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010142 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010142">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">selected r-strategy rationale</rdfs:label>
        <skos:altLabel xml:lang="en">reason for selected r-strategy</skos:altLabel>
        <skos:definition xml:lang="en">An information content entity that states the rationale for selecting a reuse, repair, remanufacturing, recycling, recovery, or disposal strategy for a product or component.</skos:definition>
        <skos:example xml:lang="en">A reason stating that reuse was rejected because mounting points were broken.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010143 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010143">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <rdfs:label xml:lang="en">selected r-strategy</rdfs:label>
        <skos:definition xml:lang="en">A directive information entity that specifies the circular economy strategy selected for a product or component.</skos:definition>
        <skos:example xml:lang="en">A selected strategy of reuse, recycling, or remanufacturing for a dismantled component.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010144 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010144">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010060"/>
        <rdfs:label xml:lang="en">actual dismantlability</rdfs:label>
        <skos:definition xml:lang="en">A disposition assessment that records how dismantlable a product or component was in an observed dismantling event.</skos:definition>
        <skos:example xml:lang="en">An actual dismantlability assessment from a dismantler after removing a door module.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010145 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010145">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010022"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: kg CO2e.</rdfs:comment>
        <rdfs:label xml:lang="en">selected r-strategy carbon footprint</rdfs:label>
        <skos:altLabel xml:lang="en">actual footprint of chosen r-strategy</skos:altLabel>
        <skos:definition xml:lang="en">A product carbon footprint that specifies the greenhouse gas emissions of the selected circular economy strategy for a component.</skos:definition>
        <skos:example xml:lang="en">3.2 kg CO2e resulting from choosing reuse for a dismantled component.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010146 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010146">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:label xml:lang="en">vehicle condition</rdfs:label>
        <skos:definition xml:lang="en">A quality of a vehicle that characterizes its observed state relevant to use, dismantling, reuse, repair, recycling, or valuation.</skos:definition>
        <skos:example xml:lang="en">A vehicle condition assessment recorded at dismantling intake.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010147 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010147">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:label xml:lang="en">drive type</rdfs:label>
        <skos:definition xml:lang="en">A quality of a vehicle that classifies its propulsion architecture or drive configuration.</skos:definition>
        <skos:example xml:lang="en">Battery electric drive, hybrid drive, or combustion engine drive.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010148 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010148">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020133"/>
        <rdfs:label xml:lang="en">empty weight</rdfs:label>
        <skos:definition xml:lang="en">A mass quality that quantifies the weight of a vehicle without load under the stated specification conditions.</skos:definition>
        <skos:example xml:lang="en">The empty weight in kilograms from vehicle documentation.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010149 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010149">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:label xml:lang="en">vehicle type</rdfs:label>
        <skos:definition xml:lang="en">A quality of a vehicle that classifies the vehicle according to its design, construction, or intended purpose.</skos:definition>
        <skos:example xml:lang="en">Passenger car, light commercial vehicle, or heavy truck.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010160 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010160">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:label xml:lang="en">model identifier</rdfs:label>
        <skos:definition xml:lang="en">An identifier assigned by an original equipment manufacturer to a vehicle model, vehicle project, or model variant.</skos:definition>
        <skos:example xml:lang="en">An original equipment manufacturer project code used to identify a vehicle model in product data.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010161 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010161">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:label xml:lang="en">vehicle series</rdfs:label>
        <skos:definition xml:lang="en">An identifier that records the vehicle series or platform series associated with a vehicle model or component.</skos:definition>
        <skos:example xml:lang="en">A vehicle series code used in dismantling or parts identification data.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010162 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010162">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000835"/>
        <rdfs:label xml:lang="en">original equipment manufacturer</rdfs:label>
        <skos:altLabel xml:lang="en">OEM</skos:altLabel>
        <skos:altLabel xml:lang="en">original equipment manufacturer</skos:altLabel>
        <skos:definition xml:lang="en">A manufacturer that designs or produces the original vehicle, component, or system for which circular economy data is recorded.</skos:definition>
        <skos:example xml:lang="en">A vehicle manufacturer recorded as the original equipment manufacturer for a vehicle series.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010163 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010163">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0001044"/>
        <rdfs:label xml:lang="en">production date</rdfs:label>
        <skos:altLabel xml:lang="en">date of production</skos:altLabel>
        <skos:definition xml:lang="en">A date value specification that records when a vehicle, component, product, or material batch was produced.</skos:definition>
        <skos:example xml:lang="en">The production date of a vehicle read from manufacturer records.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010164 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010164">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010093"/>
        <rdfs:label xml:lang="en">anonymized vehicle identification number</rdfs:label>
        <skos:altLabel xml:lang="en">VAN</skos:altLabel>
        <skos:altLabel xml:lang="en">anonymized VIN</skos:altLabel>
        <skos:altLabel xml:lang="en">vehicle anonymized number</skos:altLabel>
        <skos:definition xml:lang="en">An identifier derived from a vehicle identification number by anonymization or hashing so that the vehicle can be linked across records without exposing the original vehicle identification number.</skos:definition>
        <skos:example xml:lang="en">A hashed vehicle identification number used in circular economy data exchange.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010165 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010165">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:string; expected unit: not specified.</rdfs:comment>
        <rdfs:label xml:lang="en">name at manufacturer</rdfs:label>
        <skos:definition xml:lang="en">An identifier or designation by which a manufacturer names a material grade, product line, component, or product in its own records or commercial communication.</skos:definition>
        <skos:example xml:lang="en">A manufacturer trade name such as Ultradur, Zytel, or Grilamid.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010174 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010174">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000024"/>
        <rdfs:label xml:lang="en">corroded region</rdfs:label>
        <skos:definition xml:lang="en">A fiat object part of a material entity that is spatially demarcated by corrosion-related material alteration.</skos:definition>
        <skos:example xml:lang="en">A rusted area on a steel mounting bracket identified during dismantling inspection.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010175 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010175">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020138"/>
        <rdfs:label xml:lang="en">batch</rdfs:label>
        <skos:definition xml:lang="en">A disconnected material entity aggregate that is produced, handled, or traced as one quantity under a common production or logistics context.</skos:definition>
        <skos:example xml:lang="en">A batch of polymer granulate produced under one manufacturing order.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010176 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010176">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/log/LOG_0080002"/>
        <rdfs:label xml:lang="en">catena-x batch identifier</rdfs:label>
        <skos:altLabel xml:lang="en">Catena-X identifier</skos:altLabel>
        <skos:definition xml:lang="en">A batch identifier assigned for anonymous traceability of a batch in the Catena-X dataspace.</skos:definition>
        <skos:example xml:lang="en">A Catena-X identifier used to reference a batch without exposing a local production number.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010177 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010177">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:label xml:lang="en">local identifier</rdfs:label>
        <skos:altLabel xml:lang="en">local identifiers</skos:altLabel>
        <skos:definition xml:lang="en">An identifier that identifies an entity within a stated local system, organization, or dataspace.</skos:definition>
        <skos:example xml:lang="en">A local batch number used inside a manufacturer&apos;s production system.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010178 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010178">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">local identifier key</rdfs:label>
        <skos:altLabel xml:lang="en">identifier key</skos:altLabel>
        <skos:altLabel xml:lang="en">key value list</skos:altLabel>
        <skos:definition xml:lang="en">An information content entity that names the local identifier scheme or field in which an identifier value is given.</skos:definition>
        <skos:example xml:lang="en">A key such as plant batch number or supplier lot number in a key-value identifier list.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010179 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010179">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010177"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:string; expected unit: not specified.</rdfs:comment>
        <rdfs:label xml:lang="en">local identifier value</rdfs:label>
        <skos:altLabel xml:lang="en">identifier value</skos:altLabel>
        <skos:definition xml:lang="en">An identifier value used within a stated local identifier scheme.</skos:definition>
        <skos:example xml:lang="en">The value 2024-11-A in a supplier lot identifier.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010180 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010180">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">manufacturing information</rdfs:label>
        <skos:altLabel xml:lang="en">manufacturing entity</skos:altLabel>
        <skos:definition xml:lang="en">An information content entity that records production-related data about a batch, part, product, or material.</skos:definition>
        <skos:example xml:lang="en">Manufacturing date and manufacturing country recorded for a produced batch.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010181 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010181">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:string; expected code scheme: ISO 3166-1 alpha-2 or alpha-3.</rdfs:comment>
        <rdfs:label xml:lang="en">manufacturing country code</rdfs:label>
        <skos:altLabel xml:lang="en">country code</skos:altLabel>
        <skos:definition xml:lang="en">An identifier that records the country in which a part, product, material, or batch was manufactured.</skos:definition>
        <skos:example xml:lang="en">&quot;DE&quot; as the manufacturing country code for a part manufactured in Germany.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010182 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010182">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">part type information</rdfs:label>
        <skos:definition xml:lang="en">An information content entity that describes the designed part type instantiated by a physical part or batch.</skos:definition>
        <skos:example xml:lang="en">Part type information for a connector housing used across several produced parts.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010183 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010183">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/log/LOG_1000007"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:string; expected unit: not specified.</rdfs:comment>
        <rdfs:label xml:lang="en">manufacturer part number</rdfs:label>
        <skos:altLabel xml:lang="en">manufacturer part ID</skos:altLabel>
        <skos:definition xml:lang="en">A part number assigned by the manufacturer to a designed part type.</skos:definition>
        <skos:example xml:lang="en">A manufacturer&apos;s part number for a steering control unit housing.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010184 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010184">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:label xml:lang="en">part name at manufacturer</rdfs:label>
        <skos:definition xml:lang="en">An identifier or designation by which a manufacturer names a part type in its own records.</skos:definition>
        <skos:example xml:lang="en">A manufacturer-specific sales or engineering name for a vehicle part.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010185 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010185">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">product data</rdfs:label>
        <skos:definition xml:lang="en">An information content entity that records identifying, descriptive, composition, or lifecycle data about a product.</skos:definition>
        <skos:example xml:lang="en">A vehicle product data record containing model range, brand, production date, and material composition.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010186 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010186">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:label xml:lang="en">model range</rdfs:label>
        <skos:definition xml:lang="en">An identifier that records a vehicle sales or platform range used to group related model variants.</skos:definition>
        <skos:example xml:lang="en">A model range name used in a vehicle product data aspect.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010187 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010187">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0025001"/>
        <rdfs:label xml:lang="en">overall material composition</rdfs:label>
        <skos:definition xml:lang="en">A composition that summarizes material groups and amounts at the level of a whole product or vehicle.</skos:definition>
        <skos:example xml:lang="en">Overall material composition of a vehicle reported for homologation.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010188 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010188">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:label xml:lang="en">model range lifecycle</rdfs:label>
        <skos:definition xml:lang="en">An identifier that records the lifecycle state or generation of a vehicle model range.</skos:definition>
        <skos:example xml:lang="en">A lifecycle code for a vehicle series used in product data exchange.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010189 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010189">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:label xml:lang="en">sales name</rdfs:label>
        <skos:definition xml:lang="en">An identifier that records the commercial name under which a vehicle, part, or product is sold.</skos:definition>
        <skos:example xml:lang="en">The sales name shown in vehicle product data.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010190 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010190">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:label xml:lang="en">brand</rdfs:label>
        <skos:definition xml:lang="en">An identifier that records the commercial brand associated with a vehicle, part, material, or product.</skos:definition>
        <skos:example xml:lang="en">A vehicle brand recorded in product data.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010191 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010191">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">vehicle information</rdfs:label>
        <skos:definition xml:lang="en">An information content entity that records identifying, technical, lifecycle, or manufacturer data about a vehicle.</skos:definition>
        <skos:example xml:lang="en">Vehicle information containing original equipment manufacturer, model range, production date, and anonymized vehicle identification number.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010192 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010192">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/log/LOG_1000023"/>
        <rdfs:label xml:lang="en">recycling batch actor</rdfs:label>
        <skos:altLabel xml:lang="en">actor</skos:altLabel>
        <skos:definition xml:lang="en">A supply chain agent that participates in the transfer, treatment, or documentation of a recycling batch.</skos:definition>
        <skos:example xml:lang="en">A dismantler, recycler, logistics provider, or receiving plant recorded for a recycling batch.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010193 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010193">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/log/LOG_1000014"/>
        <rdfs:label xml:lang="en">recycling batch sender</rdfs:label>
        <skos:altLabel xml:lang="en">sender</skos:altLabel>
        <skos:definition xml:lang="en">A consignor that sends a recycling batch to another actor.</skos:definition>
        <skos:example xml:lang="en">A dismantling facility sending a sorted polymer batch to a recycler.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010194 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010194">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/log/LOG_1000013"/>
        <rdfs:label xml:lang="en">recycling batch receiver</rdfs:label>
        <skos:altLabel xml:lang="en">receiver</skos:altLabel>
        <skos:definition xml:lang="en">A consignee that receives a recycling batch from another actor.</skos:definition>
        <skos:example xml:lang="en">A recycling facility receiving a batch of dismantled polymer components.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010195 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010195">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/log/LOG_1000023"/>
        <rdfs:label xml:lang="en">recycling batch operator</rdfs:label>
        <skos:altLabel xml:lang="en">operator</skos:altLabel>
        <skos:definition xml:lang="en">A supply chain agent that operates a transport, treatment, or recycling process for a recycling batch.</skos:definition>
        <skos:example xml:lang="en">The company operating the transport process for a recycling batch.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010196 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010196">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:label xml:lang="en">actor number</rdfs:label>
        <skos:definition xml:lang="en">An identifier assigned to an actor in a recycling, logistics, or supply-chain process.</skos:definition>
        <skos:example xml:lang="en">An operating number used to identify a recycling batch actor.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010197 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010197">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">actor role type</rdfs:label>
        <skos:altLabel xml:lang="en">actor role</skos:altLabel>
        <skos:definition xml:lang="en">An information content entity that records the role type under which an actor participates in a recycling or logistics process.</skos:definition>
        <skos:example xml:lang="en">Sender, receiver, recycler, operator, or transporter recorded as an actor role type.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010198 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010198">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:label xml:lang="en">transfer identifier</rdfs:label>
        <skos:definition xml:lang="en">An identifier assigned to a transfer of material, components, products, or recycling batches between actors.</skos:definition>
        <skos:example xml:lang="en">A transfer identifier for movement of a recycling batch from dismantler to recycler.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010199 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010199">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:label xml:lang="en">global asset identifier</rdfs:label>
        <skos:altLabel xml:lang="en">global asset ID</skos:altLabel>
        <skos:altLabel xml:lang="en">global asset i d</skos:altLabel>
        <skos:definition xml:lang="en">An identifier that globally identifies an asset in a digital twin or data exchange environment.</skos:definition>
        <skos:example xml:lang="en">A global asset identifier for the digital twin of a material card or recycling batch.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010200 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010200">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0000021"/>
        <rdfs:label xml:lang="en">owner business partner number</rdfs:label>
        <skos:altLabel xml:lang="en">owner BPNL</skos:altLabel>
        <skos:altLabel xml:lang="en">owner b p n l</skos:altLabel>
        <skos:definition xml:lang="en">A business partner number that identifies the owner of a data asset, material card, or digital twin record.</skos:definition>
        <skos:example xml:lang="en">A BPNL recorded as the owner of a simulation material card.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010210 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010210">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010175"/>
        <rdfs:label xml:lang="en">recycling batch</rdfs:label>
        <skos:definition xml:lang="en">A batch that is collected, transferred, or treated as one quantity in a recycling process.</skos:definition>
        <skos:example xml:lang="en">A sorted batch of dismantled polymer components sent to a recycler.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010211 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010211">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020133"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: kg.</rdfs:comment>
        <rdfs:label xml:lang="en">container mass</rdfs:label>
        <skos:altLabel xml:lang="en">container weight</skos:altLabel>
        <skos:definition xml:lang="en">A mass quality that quantifies the empty mass of a container.</skos:definition>
        <skos:example xml:lang="en">An empty recycling container with a mass of 3000 kg.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010212 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010212">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020150"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:positiveInteger; expected unit: L.</rdfs:comment>
        <rdfs:label xml:lang="en">container volume</rdfs:label>
        <skos:definition xml:lang="en">A volume quality that quantifies the internal capacity of a container.</skos:definition>
        <skos:example xml:lang="en">A roll-off container with a capacity of 20000 L.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010213 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010213">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:label xml:lang="en">container type identifier</rdfs:label>
        <skos:definition xml:lang="en">An identifier assigned to a standardized container type.</skos:definition>
        <skos:example xml:lang="en">An AVAL container type identifier used for a recycling container.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010214 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010214">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">container description</rdfs:label>
        <skos:definition xml:lang="en">An information content entity that describes a container type or container instance.</skos:definition>
        <skos:example xml:lang="en">A standardized description such as roll-off container for a recycling batch.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010215 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010215">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/log/LOG_1000130"/>
        <rdfs:label xml:lang="en">recycling process step</rdfs:label>
        <skos:altLabel xml:lang="en">child process steps</skos:altLabel>
        <skos:altLabel xml:lang="en">process step</skos:altLabel>
        <skos:definition xml:lang="en">A business process that is a distinguishable step in the handling or treatment of a recycling batch.</skos:definition>
        <skos:example xml:lang="en">Shredding, sorting, washing, or weighing as a recycling process step.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010216 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010216">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">child process type</rdfs:label>
        <skos:definition xml:lang="en">An information content entity that classifies a subordinate process step in a recycling process.</skos:definition>
        <skos:example xml:lang="en">Shredding recorded as the child process type for a recycling batch step.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010217 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010217">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">process information</rdfs:label>
        <skos:definition xml:lang="en">An information content entity that records the type, method, timing, or outcome of a process.</skos:definition>
        <skos:example xml:lang="en">A recycling batch process record containing treatment procedure and process type.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010218 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010218">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">process type</rdfs:label>
        <skos:definition xml:lang="en">An information content entity that classifies a process according to its role in a treatment, recycling, or logistics chain.</skos:definition>
        <skos:example xml:lang="en">Sorting or transport recorded as the process type for a reverse-chain process step.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010219 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010219">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010062"/>
        <rdfs:label xml:lang="en">treatment procedure</rdfs:label>
        <skos:definition xml:lang="en">A treatment technique selected or applied for handling waste, components, materials, or recycling batches.</skos:definition>
        <skos:example xml:lang="en">An R4 treatment procedure recorded for a recycling batch.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010220 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010220">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010054"/>
        <rdfs:label xml:lang="en">mechanical recycling</rdfs:label>
        <skos:definition xml:lang="en">A recycling process that recovers material through mechanical operations without intentional chemical depolymerization.</skos:definition>
        <skos:example xml:lang="en">Sorting, shredding, washing, and regranulating polymer parts.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010221 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010221">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010054"/>
        <rdfs:label xml:lang="en">chemical recycling</rdfs:label>
        <skos:definition xml:lang="en">A recycling process that converts material through chemical reaction into monomers, feedstock, or other chemical products.</skos:definition>
        <skos:example xml:lang="en">Solvolysis or depolymerization applied to a polymer waste stream.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010222 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010222">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020133"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: kg.</rdfs:comment>
        <rdfs:label xml:lang="en">process loss</rdfs:label>
        <skos:definition xml:lang="en">A mass quality that quantifies material lost during a process step.</skos:definition>
        <skos:example xml:lang="en">A process loss of 0.5 kg during washing of a recycling batch.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010223 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010223">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">loss type</rdfs:label>
        <skos:definition xml:lang="en">An information content entity that classifies the cause or form of material loss in a process.</skos:definition>
        <skos:example xml:lang="en">Abrasion or contamination recorded as the loss type for a recycling process step.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010224 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010224">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000310"/>
        <rdfs:label xml:lang="en">weighing slip</rdfs:label>
        <skos:definition xml:lang="en">A document that records the result of weighing materials, components, products, or recycling batches.</skos:definition>
        <skos:example xml:lang="en">A weighing slip issued by a scale during intake of a recycling batch.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010225 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010225">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">measurement type</rdfs:label>
        <skos:definition xml:lang="en">An information content entity that classifies the measurement method or instrument used to obtain a value.</skos:definition>
        <skos:example xml:lang="en">Material scale recorded as the measurement type for a mass determination.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010226 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010226">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0001044"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:dateTime; expected unit: not specified.</rdfs:comment>
        <rdfs:label xml:lang="en">measurement timestamp</rdfs:label>
        <skos:definition xml:lang="en">A date value specification that records the time at which a measurement was made.</skos:definition>
        <skos:example xml:lang="en">2024-01-01T14:23:00+01:00 recorded as a measurement timestamp.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010227 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010227">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0001044"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:dateTime; expected unit: not specified.</rdfs:comment>
        <rdfs:label xml:lang="en">start timestamp</rdfs:label>
        <skos:definition xml:lang="en">A date value specification that records the start time of a process step.</skos:definition>
        <skos:example xml:lang="en">The start timestamp of a sorting step in a recycling batch process.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010228 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010228">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0001044"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:dateTime; expected unit: not specified.</rdfs:comment>
        <rdfs:label xml:lang="en">end timestamp</rdfs:label>
        <skos:definition xml:lang="en">A date value specification that records the end time of a process step.</skos:definition>
        <skos:example xml:lang="en">The end timestamp of a washing step in a recycling batch process.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010229 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010229">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020133"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: kg.</rdfs:comment>
        <rdfs:label xml:lang="en">input net mass</rdfs:label>
        <skos:definition xml:lang="en">A mass quality that quantifies the net mass entering a process step.</skos:definition>
        <skos:example xml:lang="en">Input net mass of 10.0 kg for a recycling process step.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010230 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010230">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020133"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: kg.</rdfs:comment>
        <rdfs:label xml:lang="en">output net mass</rdfs:label>
        <skos:definition xml:lang="en">A mass quality that quantifies the net mass leaving a process step.</skos:definition>
        <skos:example xml:lang="en">Output net mass of 9.5 kg after a recycling process step.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010231 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010231">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
        <rdfs:label xml:lang="en">remanufacturability</rdfs:label>
        <skos:definition xml:lang="en">A disposition of a product or component to be restored through remanufacturing to a specified performance or quality state.</skos:definition>
        <skos:example xml:lang="en">A starter motor assessed as remanufacturable after inspection.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010232 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010232">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000016"/>
        <rdfs:label xml:lang="en">refurbishability</rdfs:label>
        <skos:definition xml:lang="en">A disposition of a product or component to be restored through refurbishment to an acceptable use state.</skos:definition>
        <skos:example xml:lang="en">A body control module assessed as refurbishable after testing.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010233 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010233">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000852"/>
        <rdfs:label xml:lang="en">restricted heavy metals</rdfs:label>
        <skos:definition xml:lang="en">A material entity aggregate comprising heavy metal substances whose concentration is restricted by a stated regulation or standard.</skos:definition>
        <skos:example xml:lang="en">Lead, mercury, cadmium, and hexavalent chromium considered in ELV compliance.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010234 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010234">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:boolean; expected unit: not specified.</rdfs:comment>
        <rdfs:label xml:lang="en">lead threshold compliance</rdfs:label>
        <skos:definition xml:lang="en">A data item that records whether lead concentration complies with a stated threshold.</skos:definition>
        <skos:example xml:lang="en">A true value indicating that lead concentration is below the applicable threshold.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010235 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010235">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:boolean; expected unit: not specified.</rdfs:comment>
        <rdfs:label xml:lang="en">mercury threshold compliance</rdfs:label>
        <skos:definition xml:lang="en">A data item that records whether mercury concentration complies with a stated threshold.</skos:definition>
        <skos:example xml:lang="en">A true value indicating that mercury concentration is below the applicable threshold.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010236 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010236">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:boolean; expected unit: not specified.</rdfs:comment>
        <rdfs:label xml:lang="en">cadmium threshold compliance</rdfs:label>
        <skos:definition xml:lang="en">A data item that records whether cadmium concentration complies with a stated threshold.</skos:definition>
        <skos:example xml:lang="en">A false value indicating that cadmium concentration exceeds the applicable threshold.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010237 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010237">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:boolean; expected unit: not specified.</rdfs:comment>
        <rdfs:label xml:lang="en">hexavalent chromium threshold compliance</rdfs:label>
        <skos:definition xml:lang="en">A data item that records whether hexavalent chromium concentration complies with a stated threshold.</skos:definition>
        <skos:example xml:lang="en">A true value indicating that hexavalent chromium concentration is below the applicable threshold.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010238 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010238">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:string; expected unit: not specified.</rdfs:comment>
        <rdfs:label xml:lang="en">required tool and software</rdfs:label>
        <skos:definition xml:lang="en">A directive information entity that specifies tools and software required for disassembly, testing, treatment, or reuse assessment.</skos:definition>
        <skos:example xml:lang="en">A list requiring a diagnostic application and a puller tool for proper disassembly.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010239 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010239">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">component position</rdfs:label>
        <skos:altLabel xml:lang="en">position</skos:altLabel>
        <skos:definition xml:lang="en">An information content entity that records the position of a component within a product or vehicle.</skos:definition>
        <skos:example xml:lang="en">Front left door recorded as the component position within a vehicle.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010240 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010240">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:integer; expected unit: count.</rdfs:comment>
        <rdfs:label xml:lang="en">component quantity</rdfs:label>
        <skos:altLabel xml:lang="en">quantity</skos:altLabel>
        <skos:definition xml:lang="en">A quality that quantifies how many instances of a component occur in a product or vehicle.</skos:definition>
        <skos:example xml:lang="en">Four identical door speakers recorded as a component quantity.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010241 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010241">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:integer; expected unit: km.</rdfs:comment>
        <rdfs:label xml:lang="en">expected mileage</rdfs:label>
        <skos:definition xml:lang="en">A quality that quantifies the expected travel distance over which a component can perform its intended function.</skos:definition>
        <skos:example xml:lang="en">Expected mileage of 200000 km for a vehicle component.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010242 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010242">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">design feedback information</rdfs:label>
        <skos:altLabel xml:lang="en">feedback to design</skos:altLabel>
        <skos:definition xml:lang="en">An information content entity that records dismantling, reuse, repair, or recycling observations for later design improvement.</skos:definition>
        <skos:example xml:lang="en">Feedback that a bonded joint should be replaced by a reversible fastening for easier dismantling.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010243 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010243">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:string; expected unit: not specified.</rdfs:comment>
        <rdfs:label xml:lang="en">waste code</rdfs:label>
        <skos:definition xml:lang="en">An identifier that classifies a waste material or waste-containing part according to a stated waste code system.</skos:definition>
        <skos:example xml:lang="en">A European List of Waste code assigned to a dismantled material fraction.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010244 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010244">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">dismantling characteristics information</rdfs:label>
        <skos:altLabel xml:lang="en">dismantling information characteristics</skos:altLabel>
        <skos:definition xml:lang="en">An information content entity that records product or component characteristics relevant to dismantling.</skos:definition>
        <skos:example xml:lang="en">A dismantling characteristics record containing position, quantity, and expected mileage.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010245 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010245">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">component identification information</rdfs:label>
        <skos:altLabel xml:lang="en">identification</skos:altLabel>
        <skos:definition xml:lang="en">An information content entity that records identifiers for a product, component, vehicle, material, or batch.</skos:definition>
        <skos:example xml:lang="en">A component identification record containing part number, batch identifier, and anonymized vehicle identification number.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010246 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010246">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">circular economy information</rdfs:label>
        <skos:altLabel xml:lang="en">dismantling information circular economy</skos:altLabel>
        <skos:definition xml:lang="en">An information content entity that records reuse, repair, remanufacturing, recycling, recovery, or disposal information for a product or component.</skos:definition>
        <skos:example xml:lang="en">Circular economy information containing selected r-strategy, restricted substance compliance, and required tools.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010247 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010247">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/log/LOG_0080002"/>
        <rdfs:label xml:lang="en">recycling batch identifier</rdfs:label>
        <skos:definition xml:lang="en">A batch identifier assigned to a recycling batch for traceability.</skos:definition>
        <skos:example xml:lang="en">BATCH-0001-9999-abcd recorded as a recycling batch identifier.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010248 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010248">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">recycling information</rdfs:label>
        <skos:definition xml:lang="en">An information content entity that records recycling-related source, batch, process, composition, or actor data.</skos:definition>
        <skos:example xml:lang="en">A recycling information record containing batch identifier, material source, and consumer share.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010249 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010249">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">material source</rdfs:label>
        <skos:altLabel xml:lang="en">material source entity</skos:altLabel>
        <skos:definition xml:lang="en">An information content entity that records the source category or provenance of material used in a recycling or production context.</skos:definition>
        <skos:example xml:lang="en">Automotive post-consumer material recorded as a material source.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010250 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010250">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">sustainability information</rdfs:label>
        <skos:altLabel xml:lang="en">sustainability</skos:altLabel>
        <skos:definition xml:lang="en">An information content entity that records sustainability-related attributes of a product, material, process, or circular economy scenario.</skos:definition>
        <skos:example xml:lang="en">A sustainability record containing recycled share, carbon footprint, and lifecycle stage.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010251 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010251">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020102"/>
        <rdfs:label xml:lang="en">consumer share</rdfs:label>
        <skos:altLabel xml:lang="en">consumer share entity</skos:altLabel>
        <skos:definition xml:lang="en">A mass proportion that quantifies consumer-origin material within a material source or recycled content record.</skos:definition>
        <skos:example xml:lang="en">The post-consumer automotive share in a recycled polymer material source.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010260 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010260">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000202"/>
        <rdfs:label xml:lang="en">service life</rdfs:label>
        <skos:altLabel xml:lang="en">service life component</skos:altLabel>
        <skos:definition xml:lang="en">A temporal interval during which a component can perform its intended function under stated service conditions.</skos:definition>
        <skos:example xml:lang="en">A service life interval of 12000 h for a bearing under stated load and temperature.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010261 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010261">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010260"/>
        <rdfs:label xml:lang="en">mechanical service life component</rdfs:label>
        <skos:definition xml:lang="en">A service life component limited by mechanical loading conditions.</skos:definition>
        <skos:example xml:lang="en">A 12000 h mechanical service life component under a stated cyclic load spectrum.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010262 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010262">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010260"/>
        <rdfs:label xml:lang="en">thermal service life component</rdfs:label>
        <skos:definition xml:lang="en">A service life component limited by thermal loading conditions.</skos:definition>
        <skos:example xml:lang="en">A 9000 h thermal service life component at a stated operating temperature.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010263 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010263">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010260"/>
        <rdfs:label xml:lang="en">chemical service life component</rdfs:label>
        <skos:definition xml:lang="en">A service life component limited by chemical exposure conditions.</skos:definition>
        <skos:example xml:lang="en">A 5000 h chemical service life component under stated oil exposure.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010264 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010264">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010263"/>
        <rdfs:label xml:lang="en">chemical medium service life component</rdfs:label>
        <skos:definition xml:lang="en">A chemical service life component limited by exposure to a specified chemical medium.</skos:definition>
        <skos:example xml:lang="en">A service life component for contact with engine oil or coolant.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010265 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010265">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010263"/>
        <rdfs:label xml:lang="en">humidity medium service life component</rdfs:label>
        <skos:definition xml:lang="en">A chemical service life component limited by humidity or water exposure.</skos:definition>
        <skos:example xml:lang="en">A service life component for exposure to 85 percent relative humidity.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010266 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010266">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">usage data</rdfs:label>
        <skos:definition xml:lang="en">An information content entity that records service life, load, environmental, status, or incident data observed during product or component use.</skos:definition>
        <skos:example xml:lang="en">A usage data record containing component age, load spectrum, incidents, and service life estimates.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010267 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010267">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:label xml:lang="en">component status</rdfs:label>
        <skos:definition xml:lang="en">A quality of a component that records its functional, operational, or lifecycle state during use or assessment.</skos:definition>
        <skos:example xml:lang="en">In service, failed, removed, repaired, or reused as a component status.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010268 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010268">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000202"/>
        <rdfs:label xml:lang="en">component age in use</rdfs:label>
        <skos:altLabel xml:lang="en">age of component</skos:altLabel>
        <skos:definition xml:lang="en">A temporal interval that extends from a stated component use event to a stated observation event.</skos:definition>
        <skos:example xml:lang="en">Age of a component calculated from installation date to dismantling date.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010269 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010269">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:string; expected unit: not specified.</rdfs:comment>
        <rdfs:label xml:lang="en">incident record</rdfs:label>
        <skos:altLabel xml:lang="en">incidents</skos:altLabel>
        <skos:definition xml:lang="en">A data item that records incidents affecting a product or component during use.</skos:definition>
        <skos:example xml:lang="en">A record of overload, crash exposure, overheating, or water ingress.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010270 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010270">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <rdfs:label xml:lang="en">load spectrum</rdfs:label>
        <skos:definition xml:lang="en">A data item that represents the distribution of loads experienced by a component over time or cycles.</skos:definition>
        <skos:example xml:lang="en">A load collective describing cyclic forces experienced by a suspension component.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010271 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010271">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010270"/>
        <rdfs:label xml:lang="en">mechanical load spectrum at instance level</rdfs:label>
        <skos:altLabel xml:lang="en">mechanical load spectrum level of instance</skos:altLabel>
        <skos:definition xml:lang="en">A load spectrum that records mechanical loads experienced by one individual component or product.</skos:definition>
        <skos:example xml:lang="en">The load profile measured for one vehicle component during operation.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010272 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010272">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010270"/>
        <rdfs:label xml:lang="en">mechanical load spectrum at fleet level</rdfs:label>
        <skos:altLabel xml:lang="en">mechanical load spectrum level of fleet</skos:altLabel>
        <skos:definition xml:lang="en">A load spectrum that aggregates mechanical loads experienced by a fleet of components or products.</skos:definition>
        <skos:example xml:lang="en">An aggregated load profile calculated from all units in a fleet.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010273 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010273">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: N.</rdfs:comment>
        <rdfs:label xml:lang="en">mechanical load amplitude at instance level</rdfs:label>
        <skos:altLabel xml:lang="en">mechanical load amplitude level of instance</skos:altLabel>
        <skos:definition xml:lang="en">A quality that quantifies cyclic mechanical load amplitude experienced by one component or product.</skos:definition>
        <skos:example xml:lang="en">A 450 N peak cyclic force amplitude recorded for one component during operation.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010274 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010274">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: N.</rdfs:comment>
        <rdfs:label xml:lang="en">mechanical load amplitude at fleet level</rdfs:label>
        <skos:altLabel xml:lang="en">mechanical load amplitude level of fleet</skos:altLabel>
        <skos:definition xml:lang="en">A quality that quantifies representative cyclic mechanical load amplitude across a fleet.</skos:definition>
        <skos:example xml:lang="en">A 380 N representative cyclic force amplitude across a vehicle fleet.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010275 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010275">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:nonNegativeInteger; expected unit: cycle.</rdfs:comment>
        <rdfs:label xml:lang="en">mechanical load cycles at instance level</rdfs:label>
        <skos:altLabel xml:lang="en">mechanical load cycles level of instance</skos:altLabel>
        <skos:definition xml:lang="en">A quality that quantifies the number of mechanical load cycles experienced by one component or product.</skos:definition>
        <skos:example xml:lang="en">250000 load cycles counted for one component during operation.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010276 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010276">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:nonNegativeInteger; expected unit: cycle.</rdfs:comment>
        <rdfs:label xml:lang="en">mechanical load cycles at fleet level</rdfs:label>
        <skos:altLabel xml:lang="en">mechanical load cycles level of fleet</skos:altLabel>
        <skos:definition xml:lang="en">A quality that quantifies the number or distribution of mechanical load cycles across a fleet.</skos:definition>
        <skos:example xml:lang="en">1200000 load cycles derived from aggregated fleet operating data.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010277 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010277">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <rdfs:label xml:lang="en">temperature spectrum</rdfs:label>
        <skos:definition xml:lang="en">A data item that represents temperature magnitudes, durations, or cycles experienced by a component or product.</skos:definition>
        <skos:example xml:lang="en">A thermal load spectrum showing temperature cycles over vehicle use.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010278 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010278">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:string; expected unit: not specified.</rdfs:comment>
        <rdfs:label xml:lang="en">temperature over cycles</rdfs:label>
        <skos:definition xml:lang="en">A data item that records temperature change or temperature values across cycles.</skos:definition>
        <skos:example xml:lang="en">A temperature-over-cycles profile used in service-life assessment.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010279 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010279">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:string; expected unit: not specified.</rdfs:comment>
        <rdfs:label xml:lang="en">environmental spectrum</rdfs:label>
        <skos:definition xml:lang="en">A data item that represents environmental exposure conditions over time or cycles.</skos:definition>
        <skos:example xml:lang="en">A combined exposure profile for humidity, chemical media, radiation, and dust.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010290 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010290">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">simulation card</rdfs:label>
        <skos:definition xml:lang="en">An information content entity that specifies material, software, calibration, and parameter data used for simulation.</skos:definition>
        <skos:example xml:lang="en">A material card used for an injection molding or structural simulation.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010291 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010291">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010290"/>
        <rdfs:label xml:lang="en">material card</rdfs:label>
        <skos:altLabel xml:lang="en">simulation material card</skos:altLabel>
        <skos:definition xml:lang="en">A simulation card that specifies material data for a simulation model.</skos:definition>
        <skos:example xml:lang="en">A polymer material card calibrated for injection molding simulation.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010292 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010292">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:string; expected unit: not specified.</rdfs:comment>
        <rdfs:label xml:lang="en">simulation type</rdfs:label>
        <skos:definition xml:lang="en">An information content entity that classifies a simulation according to the modeled process or response.</skos:definition>
        <skos:example xml:lang="en">Structural simulation or manufacturing simulation recorded as a simulation type.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010293 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010293">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000010"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:string; expected unit: not specified.</rdfs:comment>
        <rdfs:label xml:lang="en">simulation software</rdfs:label>
        <skos:definition xml:lang="en">A software used to create, execute, calibrate, or interpret a simulation.</skos:definition>
        <skos:example xml:lang="en">A named simulation software and version used for a material card.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010294 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010294">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0001044"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:dateTime; expected unit: not specified.</rdfs:comment>
        <rdfs:label xml:lang="en">calibration time</rdfs:label>
        <skos:definition xml:lang="en">A date value specification that records when a simulation card or material model was calibrated.</skos:definition>
        <skos:example xml:lang="en">The calibration time of a material card used in an injection molding simulation.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010295 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010295">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:string; expected unit: not specified.</rdfs:comment>
        <rdfs:label xml:lang="en">file format</rdfs:label>
        <skos:definition xml:lang="en">An information content entity that identifies the format in which a file or simulation card is encoded.</skos:definition>
        <skos:example xml:lang="en">A material-card file format recorded for simulation data exchange.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010296 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010296">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001933"/>
        <rdfs:label xml:lang="en">manufacturing simulation parameter</rdfs:label>
        <skos:definition xml:lang="en">A value specification that provides an input, calibration, or output parameter for a manufacturing simulation.</skos:definition>
        <skos:example xml:lang="en">Specific volume or viscosity data used as a manufacturing simulation parameter.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010297 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010297">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001933"/>
        <rdfs:label xml:lang="en">structural simulation parameter</rdfs:label>
        <skos:definition xml:lang="en">A value specification that provides an input, calibration, or output parameter for a structural simulation.</skos:definition>
        <skos:example xml:lang="en">Stress, strain, or temperature values used in a structural material model.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010298 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010298">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000933"/>
        <rdfs:label xml:lang="en">fatigue simulation</rdfs:label>
        <skos:altLabel xml:lang="en">fatigue entity</skos:altLabel>
        <skos:definition xml:lang="en">A simulation process that represents material or component response under repeated cyclic loading.</skos:definition>
        <skos:example xml:lang="en">A fatigue simulation used to estimate component life under cyclic service loads.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010299 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010299">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000933"/>
        <rdfs:label xml:lang="en">creep simulation</rdfs:label>
        <skos:altLabel xml:lang="en">creep entity</skos:altLabel>
        <skos:definition xml:lang="en">A simulation process that represents time-dependent deformation under sustained load.</skos:definition>
        <skos:example xml:lang="en">A creep simulation based on strain-time curves from ISO 899 testing.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010300 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010300">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000933"/>
        <rdfs:label xml:lang="en">ageing simulation</rdfs:label>
        <skos:altLabel xml:lang="en">ageing entity</skos:altLabel>
        <skos:definition xml:lang="en">A simulation process that represents changes in material or component properties caused by ageing conditions.</skos:definition>
        <skos:example xml:lang="en">A simulation of property degradation after thermal ageing.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010301 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010301">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010297"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: K.</rdfs:comment>
        <rdfs:label xml:lang="en">parallel parameter temperature</rdfs:label>
        <skos:definition xml:lang="en">A structural simulation parameter that specifies temperature for behavior parallel to a reference direction.</skos:definition>
        <skos:example xml:lang="en">Temperature parameter parallel to fiber orientation in a material card.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010302 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010302">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010297"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: percent.</rdfs:comment>
        <rdfs:label xml:lang="en">parallel parameter expansion</rdfs:label>
        <skos:definition xml:lang="en">A structural simulation parameter that specifies expansion parallel to a reference direction.</skos:definition>
        <skos:example xml:lang="en">Expansion parameter parallel to flow direction in a material card.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010303 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010303">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010297"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: K.</rdfs:comment>
        <rdfs:label xml:lang="en">normal parameter temperature</rdfs:label>
        <skos:definition xml:lang="en">A structural simulation parameter that specifies temperature for behavior normal to a reference direction.</skos:definition>
        <skos:example xml:lang="en">Temperature parameter normal to fiber orientation in a material card.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010304 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010304">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010301"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: K.</rdfs:comment>
        <rdfs:label xml:lang="en">parallel quasistatic temperature parameter</rdfs:label>
        <skos:altLabel xml:lang="en">parallel parameter quasi static temperature</skos:altLabel>
        <skos:definition xml:lang="en">A structural simulation parameter that specifies the test temperature for quasistatic behavior parallel to a reference direction.</skos:definition>
        <skos:example xml:lang="en">Temperature used for a parallel-direction ISO 527 stress-strain curve.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010305 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010305">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010303"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: K.</rdfs:comment>
        <rdfs:label xml:lang="en">normal quasistatic temperature parameter</rdfs:label>
        <skos:altLabel xml:lang="en">normal parameter quasi static temperature</skos:altLabel>
        <skos:definition xml:lang="en">A structural simulation parameter that specifies the test temperature for quasistatic behavior normal to a reference direction.</skos:definition>
        <skos:example xml:lang="en">Temperature used for a normal-direction ISO 527 stress-strain curve.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010306 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010306">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001933"/>
        <rdfs:label xml:lang="en">simulation parameter</rdfs:label>
        <skos:definition xml:lang="en">A value specification that supplies an input, calibration, boundary, or output value for a simulation.</skos:definition>
        <skos:example xml:lang="en">A stress, strain, temperature, viscosity, or specific-volume parameter used in a material card.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010330 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010330">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020133"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: kg.</rdfs:comment>
        <rdfs:label xml:lang="en">material mass</rdfs:label>
        <skos:altLabel xml:lang="en">material weight</skos:altLabel>
        <skos:definition xml:lang="en">A mass quality that quantifies the amount of material in a part, batch, or composition entry.</skos:definition>
        <skos:example xml:lang="en">The mass of a polymer material fraction in a vehicle composition record.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010331 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010331">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020102"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: percent.</rdfs:comment>
        <rdfs:label xml:lang="en">mass fraction</rdfs:label>
        <skos:definition xml:lang="en">A mass proportion that quantifies a constituent mass relative to the total mass of the containing material, part, or product.</skos:definition>
        <skos:example xml:lang="en">The mass fraction of glass fibers in a PA66-GF25 compound.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010332 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010332">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000000"/>
        <rdfs:label xml:lang="en">material for homologation</rdfs:label>
        <skos:definition xml:lang="en">A material entity represented in homologation data for calculating recycling or recovery quotas.</skos:definition>
        <skos:example xml:lang="en">A VDA-classified material entry used in vehicle recycling quota calculation.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010333 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010333">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020102"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:double; expected unit: percent.</rdfs:comment>
        <rdfs:label xml:lang="en">homologation material share</rdfs:label>
        <skos:altLabel xml:lang="en">share</skos:altLabel>
        <skos:definition xml:lang="en">A mass proportion that quantifies the share of a material used in homologation quota calculation.</skos:definition>
        <skos:example xml:lang="en">A material share reported for a VDA material group in a vehicle homologation record.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010334 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010334">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:label xml:lang="en">VDA standard identifier</rdfs:label>
        <skos:altLabel xml:lang="en">VDA standard id</skos:altLabel>
        <skos:definition xml:lang="en">An identifier that records the VDA material classification standard used for a material entry.</skos:definition>
        <skos:example xml:lang="en">VDA 231-106 used as the standard identifier for material classification.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010335 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010335">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:label xml:lang="en">item number</rdfs:label>
        <skos:definition xml:lang="en">An identifier that records the item to which a material entry belongs in a composition or homologation structure.</skos:definition>
        <skos:example xml:lang="en">An item number for a component node in a vehicle material composition.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010336 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010336">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:label xml:lang="en">material number</rdfs:label>
        <skos:definition xml:lang="en">An identifier that records the material number in a stated material standard or classification scheme.</skos:definition>
        <skos:example xml:lang="en">A material number listed in a VDA material classification record.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010337 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010337">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <rdfs:label xml:lang="en">material standard</rdfs:label>
        <skos:altLabel xml:lang="en">standard</skos:altLabel>
        <skos:definition xml:lang="en">A plan specification that defines material classification, designation, composition, or testing requirements.</skos:definition>
        <skos:example xml:lang="en">A VDA material standard used to classify materials for homologation.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010338 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010338">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:string; expected unit: not specified.</rdfs:comment>
        <rdfs:label xml:lang="en">material physical state</rdfs:label>
        <skos:altLabel xml:lang="en">physical state</skos:altLabel>
        <skos:definition xml:lang="en">A quality of a material that classifies its state as solid, liquid, gas, powder, granulate, or another stated form.</skos:definition>
        <skos:example xml:lang="en">Granulate recorded as the physical state of a polymer feedstock.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010339 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010339">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:label xml:lang="en">material format</rdfs:label>
        <skos:definition xml:lang="en">A quality of a material that classifies the form in which the material is provided, handled, or processed.</skos:definition>
        <skos:example xml:lang="en">Pellets, flakes, powder, sheet, or compound recorded as a material format.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010340 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010340">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:label xml:lang="en">material status</rdfs:label>
        <skos:definition xml:lang="en">A quality of a material that records its state in a process, supply, use, or recycling context.</skos:definition>
        <skos:example xml:lang="en">Virgin, recycled, contaminated, dried, or approved as a material status.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010341 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010341">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0001036"/>
        <rdfs:label xml:lang="en">range of uncertainty</rdfs:label>
        <skos:definition xml:lang="en">A value specification that states the tolerance or uncertainty interval associated with a material composition or measured value.</skos:definition>
        <skos:example xml:lang="en">A plus-or-minus range reported for a recycled material share.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010342 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010342">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">chemical characterization</rdfs:label>
        <skos:definition xml:lang="en">An information content entity that describes the chemical composition or chemical properties of a material.</skos:definition>
        <skos:example xml:lang="en">A chemical characterization listing additives and regulated substances in a polymer compound.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010343 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010343">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:label xml:lang="en">thermal characterization</rdfs:label>
        <skos:definition xml:lang="en">An information content entity that describes thermal behavior or thermal properties of a material.</skos:definition>
        <skos:example xml:lang="en">A thermal characterization including glass transition temperature and thermal expansion.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010344 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010344">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000981"/>
        <rdfs:label xml:lang="en">thermophysical property</rdfs:label>
        <skos:definition xml:lang="en">A material property that characterizes a material&apos;s physical response to thermal conditions.</skos:definition>
        <skos:example xml:lang="en">Glass transition temperature or coefficient of linear thermal expansion.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010345 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010345">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000005"/>
        <rdfs:label xml:lang="en">physical property</rdfs:label>
        <skos:definition xml:lang="en">A material property that characterizes a material&apos;s physical state or behavior independently of a specific chemical reaction.</skos:definition>
        <skos:example xml:lang="en">Density, viscosity, and specific volume recorded for a polymer material.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010346 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010346">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <rdfs:label xml:lang="en">pressure-volume-temperature data</rdfs:label>
        <skos:altLabel xml:lang="en">p v t</skos:altLabel>
        <skos:altLabel xml:lang="en">pVT data</skos:altLabel>
        <skos:definition xml:lang="en">A data item that records pressure-volume-temperature behavior of a material.</skos:definition>
        <skos:example xml:lang="en">pVT curve data used for injection molding simulation of a thermoplastic.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010347 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010347">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:string; expected unit: not specified.</rdfs:comment>
        <rdfs:label xml:lang="en">material name</rdfs:label>
        <skos:definition xml:lang="en">An identifier that records the name used for a material in a stated organization, standard, or data exchange.</skos:definition>
        <skos:example xml:lang="en">Ultramid used as a material name in a material data record.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010348 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010348">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020131"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: dm3/kg.</rdfs:comment>
        <rdfs:label xml:lang="en">specific volume</rdfs:label>
        <skos:definition xml:lang="en">An intensive quality that quantifies volume per unit mass of a material.</skos:definition>
        <skos:example xml:lang="en">Specific volume of a polymer melt used in pVT data for process simulation.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010349 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010349">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000851"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: degC.</rdfs:comment>
        <rdfs:label xml:lang="en">melting temperature</rdfs:label>
        <skos:definition xml:lang="en">A melting point that is represented as a temperature value for a material under stated conditions.</skos:definition>
        <skos:example xml:lang="en">A melting temperature of 223 degC measured according to ISO 11357.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010350 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010350">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0000027"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: 1/K.</rdfs:comment>
        <rdfs:label xml:lang="en">coefficient of linear thermal expansion parallel to flow</rdfs:label>
        <skos:altLabel xml:lang="en">linear thermal expansion coefficient parallel to flow</skos:altLabel>
        <skos:definition xml:lang="en">A coefficient of linear thermal expansion measured or specified parallel to the material flow direction.</skos:definition>
        <skos:example xml:lang="en">CLTE parallel to flow for an injection molded glass-fiber-reinforced polyamide.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010351 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010351">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0000027"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: 1/K.</rdfs:comment>
        <rdfs:label xml:lang="en">coefficient of linear thermal expansion transverse to flow</rdfs:label>
        <skos:altLabel xml:lang="en">linear thermal expansion coefficient transverse to flow</skos:altLabel>
        <skos:definition xml:lang="en">A coefficient of linear thermal expansion measured or specified transverse to the material flow direction.</skos:definition>
        <skos:example xml:lang="en">CLTE transverse to flow for an injection molded glass-fiber-reinforced polyamide.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010352 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010352">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:label xml:lang="en">CAS number</rdfs:label>
        <skos:altLabel xml:lang="en">identification</skos:altLabel>
        <skos:definition xml:lang="en">An identifier assigned by the Chemical Abstracts Service to a chemical substance.</skos:definition>
        <skos:example xml:lang="en">A CAS number used to identify a chemical constituent in a material composition.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010353 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010353">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:label xml:lang="en">material composition name</rdfs:label>
        <skos:altLabel xml:lang="en">name</skos:altLabel>
        <skos:definition xml:lang="en">An identifier that records the name of a constituent or material entry in a material composition.</skos:definition>
        <skos:example xml:lang="en">The constituent name glass fiber in a composition table.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010354 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010354">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <rdfs:label xml:lang="en">pressure-volume-temperature data point</rdfs:label>
        <skos:altLabel xml:lang="en">pVT data point</skos:altLabel>
        <skos:definition xml:lang="en">A data item that records one pressure, temperature, and specific volume tuple for a material.</skos:definition>
        <skos:example xml:lang="en">A pVT data point with 80 MPa, 280 degC, and 0.91 dm3/kg for a polyamide melt.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010355 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010355">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001933"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000896"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: MPa or Pa.</rdfs:comment>
        <rdfs:label xml:lang="en">pressure-volume-temperature pressure datum</rdfs:label>
        <skos:altLabel xml:lang="en">pVT pressure datum</skos:altLabel>
        <skos:definition xml:lang="en">A value specification that records the pressure value of a pressure-volume-temperature data point.</skos:definition>
        <skos:example xml:lang="en">80 MPa recorded as the pressure datum of a pVT data point.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010356 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010356">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001933"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000967"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: degC or K.</rdfs:comment>
        <rdfs:label xml:lang="en">pressure-volume-temperature temperature datum</rdfs:label>
        <skos:altLabel xml:lang="en">pVT temperature datum</skos:altLabel>
        <skos:definition xml:lang="en">A value specification that records the temperature value of a pressure-volume-temperature data point.</skos:definition>
        <skos:example xml:lang="en">280 degC recorded as the temperature datum of a pVT data point.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0010357 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0010357">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001933"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010348"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: dm3/kg or cm3/g.</rdfs:comment>
        <rdfs:label xml:lang="en">pressure-volume-temperature specific volume datum</rdfs:label>
        <skos:altLabel xml:lang="en">pVT specific volume datum</skos:altLabel>
        <skos:definition xml:lang="en">A value specification that records the specific volume value of a pressure-volume-temperature data point.</skos:definition>
        <skos:example xml:lang="en">0.91 dm3/kg recorded as the specific volume datum of a pVT data point.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0030000 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0030000">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000967"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: degC.</rdfs:comment>
        <rdfs:label xml:lang="en">melt temperature</rdfs:label>
        <skos:definition xml:lang="en">A temperature quality that inheres in polymer melt material at a specified point or interval in a manufacturing process.</skos:definition>
        <skos:example xml:lang="en">A melt temperature of 280 degC specified for processing PA66-GF25.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0030001 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0030001">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0030000"/>
        <owl:disjointWith rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0030002"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: degC.</rdfs:comment>
        <rdfs:label xml:lang="en">maximum melt temperature</rdfs:label>
        <skos:definition xml:lang="en">A melt temperature that specifies the upper allowed or observed temperature of input melt in a manufacturing process.</skos:definition>
        <skos:example xml:lang="en">A maximum melt temperature of 290 degC in an injection molding process window.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0030002 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0030002">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0030000"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: degC.</rdfs:comment>
        <rdfs:label xml:lang="en">minimum melt temperature</rdfs:label>
        <skos:definition xml:lang="en">A melt temperature that specifies the lower allowed or observed temperature of input melt in a manufacturing process.</skos:definition>
        <skos:example xml:lang="en">A minimum melt temperature of 270 degC in an injection molding process window.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0030003 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0030003">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000967"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: degC.</rdfs:comment>
        <rdfs:label xml:lang="en">mold temperature</rdfs:label>
        <skos:definition xml:lang="en">A temperature quality that inheres in a mold during a manufacturing process.</skos:definition>
        <skos:example xml:lang="en">A mold temperature of 90 degC specified for processing a glass-fiber-reinforced polyamide.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0030004 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0030004">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0030003"/>
        <owl:disjointWith rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0030005"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: degC.</rdfs:comment>
        <rdfs:label xml:lang="en">maximum mold temperature</rdfs:label>
        <skos:definition xml:lang="en">A mold temperature that specifies the upper allowed or observed temperature of a mold during a manufacturing process.</skos:definition>
        <skos:example xml:lang="en">A maximum mold temperature of 100 degC in an injection molding process window.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0030005 -->

    <owl:Class rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0030005">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0030003"/>
        <rdfs:comment xml:lang="en">Expected value datatype: xsd:float; expected unit: degC.</rdfs:comment>
        <rdfs:label xml:lang="en">minimum mold temperature</rdfs:label>
        <skos:definition xml:lang="en">A mold temperature that specifies the lower allowed or observed temperature of a mold during a manufacturing process.</skos:definition>
        <skos:example xml:lang="en">A minimum mold temperature of 80 degC in an injection molding process window.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000000 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000000"/>
    


    <!-- https://w3id.org/pmd/co/PMD_0000002 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000002"/>
    


    <!-- https://w3id.org/pmd/co/PMD_0000005 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000005"/>
    


    <!-- https://w3id.org/pmd/co/PMD_0000008 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000008"/>
    


    <!-- https://w3id.org/pmd/co/PMD_0000577 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000577"/>
    


    <!-- https://w3id.org/pmd/co/PMD_0000602 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000602"/>
    


