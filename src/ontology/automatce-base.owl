    <!-- http://purl.obolibrary.org/obo/IAO_0000136 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/IAO_0000136"/>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0009001 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0009001">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/IAO_0020000"/>
        <rdfs:label xml:lang="en">has identifier</rdfs:label>
        <skos:definition xml:lang="en">A relation that links an entity to an identifier denoting it in a stated system.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0009002 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0009002">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <rdfs:range rdf:resource="https://w3id.org/pmd/co/PMD_0025001"/>
        <rdfs:label xml:lang="en">has material composition</rdfs:label>
        <skos:definition xml:lang="en">A relation that links a product, component, material, or batch to a composition that describes its material constitution.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0009003 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0009003">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <rdfs:range rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010250"/>
        <rdfs:label xml:lang="en">has sustainability information</rdfs:label>
        <skos:definition xml:lang="en">A relation that links an entity or process to information about sustainability-relevant attributes.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0009004 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0009004">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <rdfs:range rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010266"/>
        <rdfs:label xml:lang="en">has usage data</rdfs:label>
        <skos:definition xml:lang="en">A relation that links a product or component to data recorded during use.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0009005 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0009005">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <rdfs:range rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010246"/>
        <rdfs:label xml:lang="en">has circular economy information</rdfs:label>
        <skos:definition xml:lang="en">A relation that links a product, component, material, or batch to information about circular economy handling or assessment.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0009006 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0009006">
        <rdfs:domain rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010246"/>
        <rdfs:range rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010143"/>
        <rdfs:label xml:lang="en">has selected r-strategy</rdfs:label>
        <skos:definition xml:lang="en">A relation that links circular economy information to the selected circular economy strategy.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0009007 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0009007">
        <rdfs:domain rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010210"/>
        <rdfs:range rdf:resource="https://w3id.org/pmd/log/LOG_1000023"/>
        <rdfs:label xml:lang="en">has recycling batch actor</rdfs:label>
        <skos:definition xml:lang="en">A relation that links a recycling batch to an actor participating in its transfer, treatment, or documentation.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0009008 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0009008">
        <rdfs:domain rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010346"/>
        <rdfs:range rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010354"/>
        <rdfs:label xml:lang="en">has pressure-volume-temperature data point</rdfs:label>
        <skos:definition xml:lang="en">A relation that links pressure-volume-temperature data to one recorded pressure, temperature, and specific volume tuple.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0009009 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0009009">
        <rdfs:domain rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010354"/>
        <rdfs:range rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010355"/>
        <rdfs:label xml:lang="en">has pressure-volume-temperature pressure datum</rdfs:label>
        <skos:definition xml:lang="en">A relation that links a pressure-volume-temperature data point to its pressure value specification.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0009010 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0009010">
        <rdfs:domain rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010354"/>
        <rdfs:range rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010356"/>
        <rdfs:label xml:lang="en">has pressure-volume-temperature temperature datum</rdfs:label>
        <skos:definition xml:lang="en">A relation that links a pressure-volume-temperature data point to its temperature value specification.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/automatce/AUTOMATCE_0009011 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/automatce/AUTOMATCE_0009011">
        <rdfs:domain rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010354"/>
        <rdfs:range rdf:resource="https://w3id.org/pmd/automatce/AUTOMATCE_0010357"/>
        <rdfs:label xml:lang="en">has pressure-volume-temperature specific volume datum</rdfs:label>
        <skos:definition xml:lang="en">A relation that links a pressure-volume-temperature data point to its specific volume value specification.</skos:definition>
    </owl:ObjectProperty>
    


