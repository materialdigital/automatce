@prefix automatce: <https://w3id.org/pmd/automatce/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix pattern: <https://w3id.org/pmd/automatce/patterns/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pattern:PressureVolumeTemperatureDataPointShape
    a sh:NodeShape ;
    sh:targetClass automatce:AUTOMATCE_0010354 ;
    sh:property [
        sh:path automatce:AUTOMATCE_0009009 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class automatce:AUTOMATCE_0010355 ;
        sh:message "A pVT data point should have exactly one pressure datum." ;
    ] ;
    sh:property [
        sh:path automatce:AUTOMATCE_0009010 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class automatce:AUTOMATCE_0010356 ;
        sh:message "A pVT data point should have exactly one temperature datum." ;
    ] ;
    sh:property [
        sh:path automatce:AUTOMATCE_0009011 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class automatce:AUTOMATCE_0010357 ;
        sh:message "A pVT data point should have exactly one specific volume datum." ;
    ] .

pattern:PressureVolumeTemperatureDatumShape
    a sh:NodeShape ;
    sh:targetObjectsOf automatce:AUTOMATCE_0009009 ;
    sh:targetObjectsOf automatce:AUTOMATCE_0009010 ;
    sh:targetObjectsOf automatce:AUTOMATCE_0009011 ;
    sh:property [
        sh:path obo:OBI_0001937 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:decimal ]
            [ sh:datatype xsd:double ]
            [ sh:datatype xsd:float ]
        ) ;
        sh:message "Each pVT datum should carry one numeric value." ;
    ] .
