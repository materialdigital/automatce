@prefix automatce: <https://w3id.org/pmd/automatce/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix pattern: <https://w3id.org/pmd/automatce/patterns/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

pattern:CircularStrategySelectionShape
    a sh:NodeShape ;
    sh:targetClass automatce:AUTOMATCE_0010246 ;
    sh:property [
        sh:path automatce:AUTOMATCE_0009006 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class automatce:AUTOMATCE_0010143 ;
        sh:message "Circular economy information should state exactly one selected R-strategy." ;
    ] ;
    sh:property [
        sh:path obo:IAO_0000136 ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Circular economy information should be about the assessed product, component, material, or batch." ;
    ] .
