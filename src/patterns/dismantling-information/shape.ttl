@prefix automatce: <https://w3id.org/pmd/automatce/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix pattern: <https://w3id.org/pmd/automatce/patterns/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

pattern:DismantlingInstructionShape
    a sh:NodeShape ;
    sh:targetClass automatce:AUTOMATCE_0010059 ;
    sh:property [
        sh:path obo:IAO_0000136 ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Dismantling instructions should be about the component or assembly they describe." ;
    ] .

pattern:DismantlingDispositionShape
    a sh:NodeShape ;
    sh:targetClass automatce:AUTOMATCE_0010060 ;
    sh:property [
        sh:path obo:RO_0000052 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Dismantlability should point to its bearer when the bearer is asserted." ;
    ] .
