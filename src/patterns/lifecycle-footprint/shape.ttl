@prefix automatce: <https://w3id.org/pmd/automatce/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix pattern: <https://w3id.org/pmd/automatce/patterns/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

pattern:LifecycleFootprintShape
    a sh:NodeShape ;
    sh:targetClass automatce:AUTOMATCE_0010022 ;
    sh:property [
        sh:path obo:OBI_0001937 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:or (
            [ sh:datatype xsd:decimal ]
            [ sh:datatype xsd:double ]
            [ sh:datatype xsd:float ]
        ) ;
        sh:message "A product carbon footprint should have one numeric greenhouse gas amount." ;
    ] ;
    sh:property [
        sh:path obo:IAO_0000039 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A product carbon footprint should use an IRI for the unit when a unit is stated." ;
    ] ;
    sh:property [
        sh:path obo:IAO_0000136 ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A product carbon footprint should be about a product, component, scenario, or lifecycle stage." ;
    ] .
