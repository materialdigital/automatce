@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix pattern: <https://w3id.org/pmd/automatce/patterns/> .

pattern:IdentifierShape
    a sh:NodeShape ;
    sh:targetClass obo:IAO_0020000 ;
    sh:property [
        sh:path obo:IAO_0000219 ;
        sh:maxCount 1 ;
        sh:message "An identifier should identify at most one intended entity in an exchange record." ;
    ] ;
    sh:property [
        sh:path rdf:value ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Identifier literal values should be represented as strings when no stronger datatype is available." ;
    ] .
