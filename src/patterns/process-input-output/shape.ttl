@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix pattern: <https://w3id.org/pmd/automatce/patterns/> .

pattern:ProcessInputOutputShape
    a sh:NodeShape ;
    sh:targetClass obo:BFO_0000015 ;
    sh:property [
        sh:path obo:RO_0002233 ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A modeled transformation process should have at least one input." ;
    ] ;
    sh:property [
        sh:path obo:RO_0002234 ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A modeled transformation process should have at least one output." ;
    ] ;
    sh:property [
        sh:path obo:RO_0000057 ;
        sh:nodeKind sh:IRI ;
        sh:message "Process participants should be represented as IRIs." ;
    ] .
