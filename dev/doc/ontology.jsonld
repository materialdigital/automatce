    "@id" : "http://purl.obolibrary.org/obo/OBI_0000245"
  } ]
}, {
  "@id" : "http://xmlns.com/foaf/0.1/Person",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "person"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/NCBITaxon_9606"
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000003",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Additives are distinct from fillers (which bulk up volume) and the matrix. They perform specific chemical or physical modifications."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "additive role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/BFO_0000023"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A role borne by a substance intentionally added in relatively small amounts to modify the processing characteristics, performance properties, or cost of a base material."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "UV stabilizers added to dashboard polymers to prevent sun damage; Plasticizers added to PVC."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000004",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Organic colorants (dyes) offer high color strength and brightness but may have lower thermal stability than pigments."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "organic colorant"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/pmd/co/PMD_0000868"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000005"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A natural organic material used as a colorant in a polymer, coating, or other material system."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "Azo dyes used in interior textile coloring."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000005",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Inorganic colorants (pigments) are generally insoluble and provide opacity and high heat stability."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "inorganic colorant"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/pmd/co/PMD_0000002"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An engineered material used as an inorganic colorant in a polymer, coating, or other material system."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "Titanium dioxide (white) used in car paints."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000006",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "This role can be borne by organic dyes or inorganic pigments."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "colorant role"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000003"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A role borne by an additive substance when its primary function is to impart color to a material."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "Carbon black acting as a pigment to turn a tire black."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000007",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Expected value datatype: xsd:float; expected unit: MPa."
  }, {
    "@language" : "en",
    "@value" : "For brittle materials, this is equal to tensile strength. For ductile materials, it may be lower than the yield point."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "stress at break"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/pmd/co/PMD_0000952"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A strength that quantifies tensile stress at specimen rupture."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "A value of 150 MPa for a GF-reinforced polymer."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000008",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Can be defined descriptively (Red) or metrologically (L*a*b* coordinates)."
  }, {
    "@language" : "en",
    "@value" : "Expected value datatype: xsd:string; expected unit: not specified."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "color"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/pmd/co/PMD_0020131"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An optical property that characterizes reflected or transmitted light by hue, saturation, and brightness."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "The 'Piano Black' finish on a B-pillar trim."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000009",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Polyamides are semi-crystalline polymers known for good thermal and chemical resistance."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "polyamide"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/pmd/co/PMD_0050004"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A polymer containing repeating amide (-CONH-) linkages in the polymer backbone."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "Nylon 6, Nylon 12, Nylon 66."
  } ],
  "https://w3id.org/pmd/co/PMD_0050117" : [ {
    "@value" : "PA"
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000010",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "PA66 has a higher melting point around 260 degC than PA6 but absorbs moisture, which affects dimensional stability."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "polyamide 66"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000009"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "PA66"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A semicrystalline thermoplastic polyamide synthesized from hexamethylenediamine and adipic acid."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "Material used for cylinder head covers and radiator end tanks."
  } ],
  "https://w3id.org/pmd/co/PMD_0050117" : [ {
    "@value" : "PA66"
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000011",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The addition of 25% glass fiber significantly increases stiffness and tensile strength compared to neat PA66."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "polyamide 66 glass fiber 25 percent"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/pmd/co/PMD_0000577"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "PA66-GF25"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A composite material that has a polyamide 66 matrix and nominally 25 percent glass fiber by mass."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "Structural components in the engine bay requiring high stiffness at elevated temperatures."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000012",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "In PMD logic, this is a disconnected aggregate because the individual filaments in a bundle are distinct objects."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "fiber"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/pmd/co/PMD_0000891"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A disconnected material entity aggregate composed of elongated filament-like material parts."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "Carbon fiber tow, Aramid fibers."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000013",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Used extensively as a reinforcement agent in polymer matrix composites."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "glass fiber"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000012"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A fiber composed primarily of glass."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "E-Glass used to reinforce PA66 for automotive pedals."
  } ],
  "https://w3id.org/pmd/co/PMD_0050117" : [ {
    "@value" : "GF"
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000014",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Commonly denoted as wt%. PA66-GF25 implies a value of 0.25 or 25%."
  }, {
    "@language" : "en",
    "@value" : "Expected value datatype: xsd:float; expected unit: %."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "fiber material content mass fraction"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/pmd/co/PMD_0020102"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A mass proportion that quantifies fiber reinforcement mass relative to total composite material mass."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "25% mass fraction in PA66-GF25."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000015",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Expected value datatype: xsd:float; expected unit: %."
  }, {
    "@language" : "en",
    "@value" : "Volume fraction is more critical for micromechanical modeling (e.g., Rule of Mixtures) than mass fraction."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "fiber material content volume fraction"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/pmd/co/PMD_0020104"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "volume fraction of fibers"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A volume proportion that quantifies fiber reinforcement volume relative to total composite material volume."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "Approximately 14-15% volume fraction corresponds to 25% mass fraction for Glass/PA66."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000016",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Expected value datatype: xsd:string; expected unit: not specified."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "identifier at manufacturer"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/IAO_0020000"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An identifier assigned by a manufacturer to a product, component, material grade, or material batch in its own system."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "A manufacturer code for a specific polymer grade."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000017",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "identifier name at manufacturer"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/IAO_0020000"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An identifier that records the manufacturer name, brand name, or trade name used for a material or product."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "Zytel or Durethan used as a material trade name."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000018",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Expected value datatype: xsd:string; expected unit: not specified."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "material designation"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/IAO_0020000"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An identifier that records a standard or supplier designation for a material composition."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "PA66-GF25"
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000019",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Expected value datatype: xsd:string; expected unit: not specified."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "material identifier"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/IAO_0020000"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An identifier assigned to a material entity, material batch, material grade, or material data record."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "A material twin identifier used in data exchange."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000020",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Expected value datatype: xsd:string; expected unit: not specified."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "material batch identifier"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/pmd/log/LOG_0080002"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A batch identifier assigned to a material batch for traceability."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "Batch 2023-10-A-X55."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000021",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Expected value datatype: xsd:string; expected unit: not specified."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "business partner number"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/IAO_0020000"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An identifier assigned to a business partner in an automotive supply-chain network."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "BPNL00000003AY2 (Example BPN)."
  } ],
  "https://w3id.org/pmd/co/PMD_0050117" : [ {
    "@value" : "BPN"
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000022",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Expected value datatype: xsd:float; expected unit: not specified."
  }, {
    "@language" : "en",
    "@value" : "Indicates ductility. Low strain at break (less than 5%) suggests brittle behavior."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "strain at break"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/pmd/co/PMD_0000848"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A mechanical property that quantifies specimen strain at rupture."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "3% strain at break for a glass-filled polyamide."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000023",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Expected value datatype: xsd:float; expected unit: Pa.s."
  }, {
    "@language" : "en",
    "@value" : "Used in injection molding simulations to predict mold filling."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "viscosity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/pmd/co/PMD_0020131"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An intensive quality that quantifies a fluid material's resistance to flow."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "The melt viscosity of polypropylene at 230 degC."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000025",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Expected value datatype: xsd:float; expected unit: Pa.s."
  }, {
    "@language" : "en",
    "@value" : "Polymers are non-Newtonian; their shear viscosity decreases as shear rate increases (shear thinning)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "shear viscosity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000023"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A viscosity that quantifies resistance to flow under shear deformation."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "Viscosity curve data required for Moldflow simulation."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000026",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Below Tg, the amorphous phase is frozen; above Tg, polymer chains have mobility."
  }, {
    "@language" : "en",
    "@value" : "Expected value datatype: xsd:float; expected unit: degC."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "glass transition temperature"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/pmd/co/PMD_0000882"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A phase boundary temperature at which the amorphous phase of a polymer changes between glassy and rubbery states."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "A glass transition temperature of about 50 degC for dry PA66."
  } ],
  "https://w3id.org/pmd/co/PMD_0050117" : [ {
    "@value" : "Tg"
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000027",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Expected value datatype: xsd:float; expected unit: 1/K."
  }, {
    "@language" : "en",
    "@value" : "Used to calculate dimensional change in assemblies that combine materials with different thermal expansion behavior."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "coefficient of linear thermal expansion"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/pmd/co/PMD_0000981"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "linear thermal expansion coefficient"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A thermal property that quantifies fractional length change per unit temperature change."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "CLTE measured parallel and normal to fiber orientation in a reinforced polymer part."
  } ],
  "https://w3id.org/pmd/co/PMD_0050117" : [ {
    "@value" : "CLTE"
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000028",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Expected value datatype: xsd:float; expected unit: J kg^-1 K^-1."
  }, {
    "@language" : "en",
    "@value" : "Used to calculate cooling times in injection molding."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "specific heat capacity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/pmd/co/PMD_0000777"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A heat capacity that quantifies heat required to raise the temperature of unit mass of a substance by one temperature unit."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "A specific heat capacity of 1700 J kg^-1 K^-1 for polypropylene."
  } ],
  "https://w3id.org/pmd/co/PMD_0050117" : [ {
    "@value" : "Cp"
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000029",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Expected value datatype: xsd:float; expected unit: kJ/m^2."
  }, {
    "@language" : "en",
    "@value" : "Often measured via Charpy or Izod notched impact tests."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "impact strength"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/pmd/co/PMD_0000952"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A strength that quantifies material resistance to fracture under impact loading."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "45 kJ/m^2 notched impact strength for a bumper material."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000030",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Expected value datatype: xsd:float; expected unit: MPa / GPa."
  }, {
    "@language" : "en",
    "@value" : "Standard metric for stiffness in plastics (ISO 178)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "flexural modulus"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/pmd/co/PMD_0000949"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A stiffness that quantifies the ratio of flexural stress to flexural strain."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "Flexural modulus of 8500 MPa for PA66-GF30."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000031",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Expected value datatype: xsd:float; expected unit: MPa / GPa."
  }, {
    "@language" : "en",
    "@value" : "Relevant for snap-fit joints in automotive interiors."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "flexural strength"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/pmd/co/PMD_0000952"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A strength that quantifies maximum stress under flexural loading before yielding or rupture."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "250 MPa for a high-performance composite."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000032",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Relevant for polyamides because moisture uptake changes mechanical properties."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "humidity"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/pmd/co/PMD_0020131"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An intensive quality that quantifies water vapor content in air surrounding a material."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "50% Relative Humidity (standard conditioning atmosphere)."
  } ]
}, {
