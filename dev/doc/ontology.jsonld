    "@language" : "en",
    "@value" : "actor"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A supply chain agent that participates in the transfer, treatment, or documentation of a recycling batch."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "A dismantler, recycler, logistics provider, or receiving plant recorded for a recycling batch."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0010193",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "recycling batch sender"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/pmd/log/LOG_1000014"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "sender"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A consignor that sends a recycling batch to another actor."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "A dismantling facility sending a sorted polymer batch to a recycler."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0010194",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "recycling batch receiver"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/pmd/log/LOG_1000013"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "receiver"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A consignee that receives a recycling batch from another actor."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "A recycling facility receiving a batch of dismantled polymer components."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0010195",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "recycling batch operator"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/pmd/log/LOG_1000023"
  } ],
  "http://www.w3.org/2004/02/skos/core#altLabel" : [ {
    "@language" : "en",
    "@value" : "operator"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A supply chain agent that operates a transport, treatment, or recycling process for a recycling batch."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "The company operating the transport process for a recycling batch."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0010196",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "actor number"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/IAO_0020000"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An identifier assigned to an actor in a recycling, logistics, or supply-chain process."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "An operating number used to identify a recycling batch actor."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0010197",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
