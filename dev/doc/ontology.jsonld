    "@language" : "en",
    "@value" : "owner BPNL"
  }, {
    "@language" : "en",
    "@value" : "owner b p n l"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A business partner number that identifies the owner of a data asset, material card, or digital twin record."
