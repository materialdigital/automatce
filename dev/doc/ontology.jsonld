    "@language" : "en",
    "@value" : "global asset i d"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An identifier that globally identifies an asset in a digital twin or data exchange environment."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "A global asset identifier for the digital twin of a material card or recycling batch."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0010200",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
