  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "transfer identifier"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.obolibrary.org/obo/IAO_0020000"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An identifier assigned to a transfer of material, components, products, or recycling batches between actors."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "A transfer identifier for movement of a recycling batch from dismantler to recycler."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0010199",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
