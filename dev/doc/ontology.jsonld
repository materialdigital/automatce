    "@language" : "en-us",
    "@value" : "planned process which is prescribed by a plan specification with one or more objectives specified by a business organization"
  } ]
}, {
  "@id" : "https://w3id.org/pmd/log/LOG_1000140",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
