  "http://purl.obolibrary.org/obo/IAO_0000115" : [ {
    "@language" : "en",
    "@value" : "This relation obtains between a planned process and a objective specification when the criteria specified in the objective specification are met at the end of the planned process."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://purl.obolibrary.org/obo/COB_0000035"
  } ],
