  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@value" : "relation from a material entity to a person or a group of agents or engineered system that holds when the material entity participates in some planned process in order to fulfill an objective for the person or group of agents or engineered system"
  } ]
