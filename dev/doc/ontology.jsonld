  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "A BPNL recorded as the owner of a simulation material card."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0010210",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
