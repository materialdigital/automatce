  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0010192",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "recycling batch actor"
  } ],
