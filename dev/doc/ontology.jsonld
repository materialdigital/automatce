    "@language" : "en",
    "@value" : "owner business partner number"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0000021"
