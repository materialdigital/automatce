  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A document that records the result of weighing materials, components, products, or recycling batches."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "A weighing slip issued by a scale during intake of a recycling batch."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0010225",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
