    "@language" : "en",
    "@value" : "has relational quality"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://purl.obolibrary.org/obo/BFO_0000145"
  } ],
  "http://www.w3.org/2002/07/owl#inverseOf" : [ {
    "@id" : "https://w3id.org/pmd/co/PMD_0025999"
  } ],
  "http://www.w3.org/2002/07/owl#propertyChainAxiom" : [ {
    "@list" : [ {
      "@id" : "http://purl.obolibrary.org/obo/BFO_0000051"
    }, {
      "@id" : "https://w3id.org/pmd/co/PMD_0025998"
    } ]
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "a relation between an independent continuant (the bearer) and a relational quality, in which the quality specifically depends on the bearer for its existence"
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "material has relational quality mass proportion m, and portion of iron has the same relational quality mass proportion m"
  } ]
}, {
  "@id" : "https://w3id.org/pmd/co/PMD_0025999",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "relational quality of"
  } ],
  "http://www.w3.org/2002/07/owl#propertyChainAxiom" : [ {
    "@list" : [ {
      "@id" : "https://w3id.org/pmd/co/PMD_0025999"
    }, {
      "@id" : "http://purl.obolibrary.org/obo/BFO_0000050"
    } ]
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "a relation between a relational quality and an independent continuant (the bearer), in which the quality specifically depends on the bearer for its existence"
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "mass proportion m is relational qualitiy of material, and the same mass proportion m is relational qualitiy of portion of iron"
  } ]
}, {
  "@id" : "https://w3id.org/pmd/co/PMD_0040001",
