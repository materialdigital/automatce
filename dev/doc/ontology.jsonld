  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "An information content entity that classifies the cause or form of material loss in a process."
  } ],
  "http://www.w3.org/2004/02/skos/core#example" : [ {
    "@language" : "en",
    "@value" : "Abrasion or contamination recorded as the loss type for a recycling process step."
  } ]
}, {
  "@id" : "https://w3id.org/pmd/automatce/AUTOMATCE_0010224",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "weighing slip"
