  }, {
    "@id" : "_:genid383"
  } ],
  "http://www.w3.org/2002/07/owl#equivalentClass" : [ {
    "@id" : "_:genid379"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en-us",
    "@value" : "identifier that uniquely denotes a particular quantity of material entities that have shared production or transformation history"
  } ]
}, {
