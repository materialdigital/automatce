                                                   rdfs:subClassOf <http://purl.obolibrary.org/obo/OBI_0001933> ,
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty <http://purl.obolibrary.org/obo/IAO_0000136> ;
                                                                     owl:someValuesFrom <https://w3id.org/pmd/co/PMD_0000967>
