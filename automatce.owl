                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000661"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000790"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">optical glass</rdfs:label>
        <skos:definition xml:lang="en">glass manufactured for optical components</skos:definition>
        <skos:example>e.g., lenses, prisms, mirrors</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050133 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050133">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000661"/>
