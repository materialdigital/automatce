     xmlns:void="http://rdfs.org/ns/void#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">
    <owl:Ontology rdf:about="https://w3id.org/pmd/automatce.owl">
        <owl:versionIRI rdf:resource="https://w3id.org/pmd/automatce/releases/2026-06-19/automatce.owl"/>
        <dc:contributor rdf:resource="https://orcid.org/0000-0003-0473-0070"/>
        <dc:contributor rdf:resource="https://orcid.org/0000-0003-0744-8855"/>
        <dc:contributor rdf:resource="https://orcid.org/0009-0003-1503-4422"/>
        <dc:contributor rdf:resource="https://orcid.org/0009-0007-7468-3544"/>
        <dc:creator rdf:resource="https://orcid.org/0000-0003-0473-0070"/>
        <dc:creator rdf:resource="https://orcid.org/0000-0003-0744-8855"/>
        <dc:creator rdf:resource="https://orcid.org/0009-0003-1503-4422"/>
        <dc:creator rdf:resource="https://orcid.org/0009-0007-7468-3544"/>
        <dc:description>Application ontology for automotive circular-economy product, material, sustainability, usage, dismantling, engineering and transactional data aligned to PMDCore and BFO 2020.</dc:description>
        <dc:license rdf:resource="https://w3id.org/pmd/automatce.owl#CC-BY-4.0"/>
        <dc:title>Automotive Circular Economy Ontology</dc:title>
        <owl:versionInfo>2026-06-19</owl:versionInfo>
    </owl:Ontology>
    


