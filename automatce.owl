        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">lot role</rdfs:label>
        <skos:definition xml:lang="en-us">traceable resource unit role held by material entities that have a shared production or transformation history</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/log/LOG_1000081 -->

