        <rdfs:label xml:lang="en">packaging plan specification</rdfs:label>
        <skos:definition xml:lang="en-us">plan specification that prescribes a packaging process</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/log/LOG_1000097 -->

