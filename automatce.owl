        <rdfs:label xml:lang="en">supply chain plan specification</rdfs:label>
        <skos:definition xml:lang="en-us">plan specification that has one or more supply chain objective specifications as parts and that prescribes a supply chain process</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/log/LOG_1000102 -->

    <owl:Class rdf:about="https://w3id.org/pmd/log/LOG_1000102">
