                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000066"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0001028"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000016"/>
                                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000005"/>
                                </owl:unionOf>
                            </owl:Class>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000950"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">material reacting process has always energy minimization as a driving force.</rdfs:comment>
        <rdfs:label xml:lang="en">material reacting process</rdfs:label>
        <skos:definition xml:lang="en">Material reacting process is a process which occurs in a portion of matter due to some of its disposition or behavioral material property which has realization in some  stimulating process. Both the material reacting process and stimulating process must be occurent parts of a planned process, if the planned process takes place.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0040001 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0040001">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020132"/>
        <rdfs:comment xml:lang="en">Length is a size that describes the spatial extent of its bearer in one dimension.</rdfs:comment>
        <rdfs:label xml:lang="en">length</rdfs:label>
        <skos:altLabel xml:lang="en">dimension</skos:altLabel>
        <skos:definition xml:lang="en">Length is a one dimensional size.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0040129 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0040129">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000005"/>
        <rdfs:comment xml:lang="en">Bridge axiom for the PMD class stub referenced by the LOG import.</rdfs:comment>
        <rdfs:label xml:lang="en">supply chain objective specification</rdfs:label>
        <skos:definition xml:lang="en">An objective specification that states an objective for a supply chain process.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050000 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000145"/>
        <rdfs:label xml:lang="en">bond</rdfs:label>
        <skos:definition xml:lang="en">A bond is a relational quality describing the force interaction between atoms.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050002 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050002">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050000"/>
        <rdfs:label xml:lang="en">metallic bond</rdfs:label>
        <skos:definition xml:lang="en">A metallic bond is a bond that forms between metal atoms, where electrons are shared in a &quot;sea&quot; of electrons that move freely around the metal ions. This type of bonding gives metals their characteristic properties such as conductivity and malleability.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050004 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050004">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000888"/>
        <rdfs:label xml:lang="en">thermoplastic polymer</rdfs:label>
        <skos:definition xml:lang="en">polymer that becomes moldable when heated and solidifies upon cooling</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050118 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050118">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000661"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
