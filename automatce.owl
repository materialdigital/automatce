        <rdfs:label xml:lang="en">raw material</rdfs:label>
        <skos:definition xml:lang="en-us">material entity which has the raw material role</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/log/LOG_1000105 -->

    <owl:Class rdf:about="https://w3id.org/pmd/log/LOG_1000105">
