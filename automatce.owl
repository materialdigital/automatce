                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">transportation service</rdfs:label>
        <skos:definition xml:lang="en-us">business process that results in placing a material entity in the possession of some agent without changing the ownership until the material entity is sold</skos:definition>
        <skos:definition>logistics service that consists of at least one transport process</skos:definition>
    </owl:Class>
