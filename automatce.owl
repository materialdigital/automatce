            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">commercial service</rdfs:label>
        <skos:definition xml:lang="en-us">business process that consists of a service provisioning process and a consumption process</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/log/LOG_1000113 -->

    <owl:Class rdf:about="https://w3id.org/pmd/log/LOG_1000113">
