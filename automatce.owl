            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">manufacturing service</rdfs:label>
        <skos:definition>commercial service that consists of at least one manufacturing process</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/log/LOG_1000121 -->

    <owl:Class rdf:about="https://w3id.org/pmd/log/LOG_1000121">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/log/LOG_1000130"/>
