                            <rdf:Description rdf:about="https://w3id.org/pmd/log/LOG_1000029"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">buying business process</rdfs:label>
        <skos:definition xml:lang="en-us">business process wherein a financial instrument is used by an agent (buyer) to acquire ownership of a product or commercial service from another agent (seller) for the buyer itself or for another agent (customer)</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/log/LOG_1000112 -->

    <owl:Class rdf:about="https://w3id.org/pmd/log/LOG_1000112">
