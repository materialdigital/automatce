                            <rdf:Description rdf:about="https://w3id.org/pmd/log/LOG_1000143"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">logistics service</rdfs:label>
        <skos:definition xml:lang="en-us">commercial service that consists of at least one transport process, packaging process, freight forwarding, or storage process</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/log/LOG_1000117 -->

    <owl:Class rdf:about="https://w3id.org/pmd/log/LOG_1000117">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/log/LOG_1000113"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/log/LOG_1000113"/>
