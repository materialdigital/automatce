        <rdfs:label xml:lang="en">raw material role</rdfs:label>
        <skos:definition xml:lang="en-us">role held by a material entity when it is acquired by an organizational entity with some plan to transform or modify it into intermediate-level components or substances or into a product</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/log/LOG_1000080 -->

    <owl:Class rdf:about="https://w3id.org/pmd/log/LOG_1000080">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/log/LOG_1000084"/>
