        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">shipment role</rdfs:label>
        <skos:definition xml:lang="en-us">traceable resource unit role held by material entities when they undergo the same dispatch and receipt processes as prescribed by a bill of lading</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/log/LOG_1000082 -->

    <owl:Class rdf:about="https://w3id.org/pmd/log/LOG_1000082">
